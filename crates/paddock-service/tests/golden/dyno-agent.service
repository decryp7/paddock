# Generated by paddock-service from the app's ServiceSpec; do not edit, change the spec instead.
[Unit]
Description=Dyno agent (measures and keeps your PC's history)
Documentation=https://dev.decryptology.net/decryp7/dyno

[Service]
Type=simple
ExecStart="/opt/Dyno App/dyno-agent" "run"
Restart=always
RestartSec=5
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dyno-agent
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryHigh=256M

[Install]
WantedBy=default.target
