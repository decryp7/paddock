{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.decryptology.net/decryp7/paddock/crates/paddock-bench/results.schema.json",
  "title": "Paddock benchmark results",
  "description": "One app's benchmark run (paddock_bench::Results). The values are in the unit of the measurement's kind: ms for startup, first-event and query-latency, items per second for throughput, MB for memory.",
  "type": "object",
  "required": ["version", "app", "app_version", "host", "measurements"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "app": { "type": "string", "minLength": 1 },
    "app_version": { "type": "string" },
    "commit": { "type": ["string", "null"] },
    "host": {
      "type": "object",
      "required": ["os", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpus": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "kind", "value", "runs"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "\\S" },
          "kind": { "enum": ["startup", "throughput", "first-event", "query-latency", "memory"] },
          "value": { "type": "number", "minimum": 0 },
          "runs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
