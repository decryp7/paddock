; Generated by paddock-service from the app's ServiceSpec; do not edit, change the spec instead.
; Per-user installer: PaddockShellDemo never registers its agent here (the user opts in in the app).

!macro NSIS_HOOK_PREINSTALL
  IfFileExists "$INSTDIR\shell-demo-agent.exe" 0 +3
    nsExec::ExecToLog '"$INSTDIR\shell-demo-agent.exe" stop'
    Pop $0
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  IfFileExists "$INSTDIR\shell-demo-agent.exe" 0 +5
    nsExec::ExecToLog '"$INSTDIR\shell-demo-agent.exe" uninstall'
    Pop $0
    nsExec::ExecToLog '"$INSTDIR\shell-demo-agent.exe" stop'
    Pop $0
!macroend
