  <diagram id="Pitwall at a glance" name="Pitwall at a glance">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="900" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitwall at a glance&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;Overview&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1720" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Apps and tools speak standard APIs to one windowless server on 127.0.0.1; the server loads models into engine processes, frees memory when they are idle, and downloads only what you ask for.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1460" y="866" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Suite apps&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Debrief · Pitcrew · Spotter · Dyno]&lt;/i&gt;&lt;br&gt;Pair once with a six-digit code; then use /x/v1 and the standard APIs.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Other AI tools&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OpenAI · Anthropic · Ollama clients]&lt;/i&gt;&lt;br&gt;Point the base URL at 127.0.0.1:11435.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="g" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Pitwall server&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[windowless · 127.0.0.1 only]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="760" height="560" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;HTTP APIs&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[axum]&lt;/i&gt;&lt;br&gt;OpenAI /v1, Anthropic /v1/messages, Ollama /api, /x/v1 (health, pair, select, tasks, tokens, jobs), provenance headers, typed errors.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="470" y="220" width="700" height="90" as="geometry"/></mxCell>
        <mxCell id="q" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Queue&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitwall-core]&lt;/i&gt;&lt;br&gt;Interactive, background, batch; caps; aging.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#DFF4EB;strokeColor=#1BAF7A;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="mem" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Memory policy&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitwall-core]&lt;/i&gt;&lt;br&gt;Fit check, load on first use, idle and pressure release.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#DFF4EB;strokeColor=#1BAF7A;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="sec" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Keys and limits&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitwall-core]&lt;/i&gt;&lt;br&gt;Hashed keys, permissions, rate and token budgets.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#DFF4EB;strokeColor=#1BAF7A;" vertex="1" parent="1"><mxGeometry x="970" y="350" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="lib" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Model library and engines&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitwall-server]&lt;/i&gt;&lt;br&gt;Hugging Face GGUF downloads with SHA-256 and GGUF check; llama.cpp installs with self-test and rollback; packs.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="470" y="540" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="egress" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Egress&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[the only outbound client]&lt;/i&gt;&lt;br&gt;HTTPS to allow-listed Hugging Face and GitHub hosts only; offline mode turns it off.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="840" y="540" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="eng" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Engine processes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[llama.cpp, one per hot model]&lt;/i&gt;&lt;br&gt;Metal, CUDA, Vulkan or CPU build. Loopback only, private key, scrubbed environment.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FDF3D9;strokeColor=#C98500;" vertex="1" parent="1"><mxGeometry x="1320" y="220" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Pitwall app and tray&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri 2 + Angular]&lt;/i&gt;&lt;br&gt;Dashboard, models, engines, apps, requests, playground, settings.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#D4440D;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1320" y="420" width="380" height="130" as="geometry"/></mxCell>
