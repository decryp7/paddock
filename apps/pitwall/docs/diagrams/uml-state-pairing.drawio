        <mxCell id="c116" value="The app keeps the key in the OS credential store. An approved request for a known app name adds a key and replaces its permissions; the owner can revoke any key at any time." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFF9E0;strokeColor=#C98500;strokeWidth=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="500" height="90" as="geometry"/></mxCell>
