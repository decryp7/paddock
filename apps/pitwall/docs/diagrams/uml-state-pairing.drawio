<mxfile host="drawio" version="32.5.5" compressed="false">
  <diagram id="States of a pairing request" name="States of a pairing request">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;States of a pairing request&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1024" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;UML · State machine diagram&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1024" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;An app is not trusted until the user approves its six-digit code in Pitwall. The key is handed over once; an unanswered request expires after five minutes (ADR 0007, 0009).&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1024" height="20" as="geometry"/></mxCell>
        <mxCell id="wt" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Waiting&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;POST /x/v1/pair accepted; at most 8 pending; the code is shown in Pitwall. Polls answer pending.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="168" width="216" height="128" as="geometry"/></mxCell>
        <mxCell id="ap" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Approved&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The user approved with permissions; a key was created and its hash stored.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="424" y="168" width="216" height="128" as="geometry"/></mxCell>
        <mxCell id="dv" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Delivered&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The poll received the key once; later polls get key: null.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="752" y="168" width="216" height="128" as="geometry"/></mxCell>
        <mxCell id="dn" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Denied&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The user denied it. The poll answers denied.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="368" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Expired&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Five minutes passed without an answer. The poll answers denied.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="424" y="368" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="ini" value="" style="ellipse;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="224" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ini" target="wt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="wt" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Approve&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="339" y="208" width="59" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ap" target="dv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Key fetched&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="655" y="208" width="83" height="18" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.3009;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3009;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="wt" target="dn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Deny&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="169" y="323" width="38" height="18" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.8519;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1991;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="wt" target="ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="336"/><mxPoint x="467" y="336"/></Array></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;5 minutes pass&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="481" y="340" width="101" height="18" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;span style=&quot;font-size:12px&quot;&gt;The app keeps the key in the OS credential store. A known app name adds a key and replaces its permissions; the owner can revoke any key.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="752" y="392" width="216" height="128" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="560" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="rounded=1;absoluteArcSize=1;arcSize=4;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);" vertex="1" parent="1"><mxGeometry x="64" y="572" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;State&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="100" y="571" width="41" height="18" as="geometry"/></mxCell>
