<mxfile host="drawio" version="32.5.5" compressed="false">
  <diagram id="States of a cache entry" name="States of a cache entry">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;States of a cache entry&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1280" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;UML · State machine diagram&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1280" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;An answer or an embedding is stored, may be used, and ends expired and swept, evicted over the size cap, or dropped when its model, engine or preset changes. An expired entry is never served, even before the sweep (ADR 0019).&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1280" height="20" as="geometry"/></mxCell>
        <mxCell id="st" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Stored&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Written by the writer thread after a completed answer or a computed vector; expiry clock starts.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="248" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="us" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Used&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;A hit: last-used time and hit count are updated; embeddings renew their expiry.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="424" y="248" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Expired&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Past its expiry (answers: since stored; embeddings: since last use). Never served.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="752" y="248" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="sw" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Swept&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Removed by the background sweep: at startup, hourly and when idle, at most 5,000 entries a pass.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1080" y="248" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="ev" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Evicted&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Over the size cap: least recently used first.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="424" y="448" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="dr" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Dropped&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Its model was removed, the engine build or pin changed, or the preset changed.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6D3FD6,#A58BFA);fillColor=light-dark(#F0ECFB,#2C2A3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="448" width="216" height="104" as="geometry"/></mxCell>
        <mxCell id="ini" value="" style="ellipse;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="56" y="192" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1019;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ini" target="st"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="64" y="224"/><mxPoint x="118" y="224"/></Array></mxGeometry></mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="st" target="us"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Hit&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="354" y="276" width="28" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="us" target="ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Time passes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="654" y="276" width="84" height="18" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ex" target="sw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Sweep&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="1000" y="276" width="49" height="18" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.6991;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3009;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="st" target="ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="247" y="220"/><mxPoint x="817" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Never used, time passes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="453" y="196" width="159" height="18" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="us" target="ev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Cap exceeded&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="540" y="391" width="90" height="18" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="st" target="dr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Invalidated&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="212" y="391" width="81" height="18" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;span style=&quot;font-size:12px&quot;&gt;Clear now, or clear per app, per model or all, removes entries in any state. A request with Cache-Control: no-cache neither reads nor writes. Expiry options: 1 h, 1 day, 7 days, 30 days, 90 days, never.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="752" y="448" width="544" height="104" as="geometry"/></mxCell>
