        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 3 — Components of the Angular UI&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Standalone components over SignalStores; every backend call goes through the BACKEND token (the Tauri backend, or the mock for browser development and tests). The UI shows what the server computes and re-implements no domain rule (AGENTS.md).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1560" y="1366" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="gf" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Features&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[standalone components, OnPush, one page each]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1820" height="420" as="geometry"/></mxCell>
        <mxCell id="f_dashboard" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dashboard&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/dashboard]&lt;/i&gt;&lt;br&gt;Stat tiles, hot models with idle countdown, queue, pairing card, apps, events feed, history charts.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_models" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;models&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/models]&lt;/i&gt;&lt;br&gt;Library, Hugging Face discover with the fit check, downloads list.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="425" y="190" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_engines" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;engines&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/engines]&lt;/i&gt;&lt;br&gt;Builds, install with progress, self-test result, select, roll back, engine packs.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="780" y="190" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_apps" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;apps&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/apps]&lt;/i&gt;&lt;br&gt;Apps and keys, pairing approval, permissions editor, key shown once.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="1135" y="190" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_requests" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;requests&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/requests]&lt;/i&gt;&lt;br&gt;Recent requests with timing and chosen model; prompts only on demand.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="1490" y="190" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_playground" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;playground&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/playground]&lt;/i&gt;&lt;br&gt;Chat with a local model, streamed through the management API.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_benchmarks" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;benchmarks&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/benchmarks]&lt;/i&gt;&lt;br&gt;Tokens per second and time to first token per model.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="425" y="370" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_settings" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;settings&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/settings]&lt;/i&gt;&lt;br&gt;General, server, memory presets and idle release, network, privacy.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="780" y="370" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="f_tray" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;tray&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/features/tray]&lt;/i&gt;&lt;br&gt;Compact view for the tray and menu bar.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="1135" y="370" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="gs" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;State&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SignalStores]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1820" height="230" as="geometry"/></mxCell>
        <mxCell id="st" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Feature stores&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[one SignalStore per page]&lt;/i&gt;&lt;br&gt;Load through the backend, keep loading, error and Retry state, expose signals. Pure view helpers in shared/format and shared/labels.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="live" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;LiveStore&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[core/live.store, live-reducer]&lt;/i&gt;&lt;br&gt;Applies pushed updates (memory, models, queue, throughput, pairing) so tiles move without polling.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="shared" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Shared UI&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[shared/ui, charts, theme tokens, icons]&lt;/i&gt;&lt;br&gt;Design tokens (dark, light), ECharts wrapper, own SVG icons, native-feel rules, toasts.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="1330" y="660" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="gc" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Backend boundary&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src/app/core]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1820" height="290" as="geometry"/></mxCell>
        <mxCell id="port" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PitwallBackend&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[interface + BACKEND token]&lt;/i&gt;&lt;br&gt;One method per management call and a live feed; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;api.types.ts&lt;/span&gt; is the wire contract mirrored by &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pitwall_core::mgmt&lt;/span&gt;.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="70" y="940" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="tauri" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;TauriBackend&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[core/tauri-backend]&lt;/i&gt;&lt;br&gt;Invokes the shell’s commands and subscribes to its live event. The only code that calls Tauri.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="620" y="940" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="mock" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;MockBackend&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[browser development and tests only]&lt;/i&gt;&lt;br&gt;Plausible data; never the reference for behaviour.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="1450" y="940" width="380" height="200" as="geometry"/></mxCell>
