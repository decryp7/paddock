        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;The main types and how they relate, from pitwall-core (green, pure values) and pitwall-server (blue, what holds state and processes). Members are abridged to the ones that carry the design.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1660" y="1966" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="settings" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Settings&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;version: u32&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;general, server, network, privacy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;memory: MemorySettings&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;models: ModelSettings (prefs per model)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;engines: EngineSettings&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;load(text, backup) → Settings&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="policy" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Policy&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;idle_unload, deep_idle: Millis&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;release_context_first: bool&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pressure_available_percent: u8&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;min_free: u64&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;max_hot: usize&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;hot_cap: Option&amp;lt;u64&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;yield_to_foreground: bool&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;preset(Preset) → Policy&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="320" height="170" as="geometry"/></mxCell>
        <mxCell id="hot" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Hot&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;id: ModelId&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ram, vram: u64&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pinned: bool&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;active: usize&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;loading: bool&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;last_used: Millis&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;idle_override: Option&amp;lt;Millis&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;plan_release(…) → Vec&amp;lt;Action&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;plan_load(…) → LoadPlan&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="320" height="185" as="geometry"/></mxCell>
        <mxCell id="caps" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Caps&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;max_running: usize&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;per_model: usize&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;max_waiting: usize&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;aging: Millis&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="150" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="prio" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;div style=&quot;font-size:11px;color:#555A65&quot;&gt;«enum»&lt;/div&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Priority&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Interactive&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Background&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Batch&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;parse(&amp;amp;str) → Option&amp;lt;Priority&amp;gt;&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1580" y="150" width="320" height="124" as="geometry"/></mxCell>
        <mxCell id="preset" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;div style=&quot;font-size:11px;color:#555A65&quot;&gt;«enum»&lt;/div&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Preset&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;LowMemory&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Balanced&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Performance&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Custom&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="440" width="320" height="124" as="geometry"/></mxCell>
        <mxCell id="hotmodel" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #2A78D6&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;HotModel&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;id: ModelId&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ram, vram, context&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;active, last_used (atomics)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;vision: bool, cold_start_ms&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;capabilities: Vec&amp;lt;Capability&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;as_hot(pinned, idle) → Hot&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="sched" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Scheduler&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;submit(JobSpec, now) → JobId&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;dispatch(now) → Vec&amp;lt;JobId&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;cancel(JobId) → Cancelled&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;set_paused(bool)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="440" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="job" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #1BAF7A&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Job&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;id: JobId&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;spec: JobSpec&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;state: Queued | Running&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;submitted_at, started_at&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;progress, tokens&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#1BAF7A;fillColor=#DFF4EB;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1580" y="440" width="320" height="125" as="geometry"/></mxCell>
        <mxCell id="engine" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #2A78D6&quot;&gt;&lt;div style=&quot;font-size:11px;color:#555A65&quot;&gt;«trait»&lt;/div&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Engine&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;kind() → EngineKind&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;id() → String&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;availability() → Availability&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;start(&amp;amp;Launch) → Running&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="320" height="124" as="geometry"/></mxCell>
        <mxCell id="running" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #2A78D6&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Running&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;child: Option&amp;lt;Child&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;client: loopback::Client&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;port: u16&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;props: llama::Props&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="440" y="730" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="serving" value="&lt;div style=&quot;text-align:center;padding-bottom:4px;border-bottom:1px solid #2A78D6&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Serving&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-top:4px;line-height:1.3&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;hot: Map&amp;lt;ModelId, HotModel&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;sched: Scheduler&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;resolve(ModelRef) → Resolved&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;acquire(app, model, priority) → Permit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ensure(ModelId) → (Busy, cold_ms)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;tick() → Vec&amp;lt;Action&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;unload(ModelId, ReleaseReason)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=4;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=left;verticalAlign=top;spacing=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="730" width="720" height="155" as="geometry"/></mxCell>
