<mxfile host="drawio" agent="Pitwall diagram generator" version="24.7.17" compressed="false">
  <diagram id="Pitwall — deployment" name="Pitwall — deployment">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="1300" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitwall — deployment&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1920" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · Deployment diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1920" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Per OS: the OS service manager keeps the windowless server alive in the user’s session; the app and tray only manage it; each hot model is a llama-server child. PITWALL_HOME overrides the data folder.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1660" y="1266" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="o0g" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Windows 10/11&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[x64]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="600" height="960" as="geometry"/></mxCell>
        <mxCell id="o0svc" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Windows service “Pitwall”&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Service Control Manager · LocalSystem]&lt;/i&gt;&lt;br&gt;Thin supervisor &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pitwall-server --service&lt;/span&gt;: starts the server in the user’s session (active, then console, then lowest id) and again when it exits; restarts after 10 s, 60 s, 5 min.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="460" height="140" as="geometry"/></mxCell>
        <mxCell id="o0srv" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;pitwall-server.exe&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[runs as the logged-on user]&lt;/i&gt;&lt;br&gt;Binds 127.0.0.1:11435. Engines, GPU access and data belong to the user, not to the service.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="460" height="120" as="geometry"/></mxCell>
        <mxCell id="o0eng" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;llama-server.exe children&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Vulkan, CUDA or CPU build]&lt;/i&gt;&lt;br&gt;No console window, below-normal priority, scrubbed environment.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FDF3D9;strokeColor=#C98500;" vertex="1" parent="1"><mxGeometry x="90" y="550" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o0app" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitwall.exe&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri 2 · WebView2]&lt;/i&gt;&lt;br&gt;Window and tray. Closing the window leaves the server running.&lt;br&gt;A second launch focuses it.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#D4440D;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="90" y="710" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o0data" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;%APPDATA%\Pitwall&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[data folder]&lt;/i&gt;&lt;br&gt;settings.toml, apps.json, admin.key, models, engines&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="860" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o0inst" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;NSIS installer&lt;/b&gt;&lt;br&gt;built unsigned until signing secrets exist&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="90" y="1000" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="c104" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0svc" target="o0srv"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="330" as="sourcePoint"/><mxPoint x="320" y="380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c105" value="Starts, restarts" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="368" y="347" width="104" height="17" as="geometry"/></mxCell>
        <mxCell id="c106" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0srv" target="o0eng"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="500" as="sourcePoint"/><mxPoint x="320" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c107" value="Child per hot model, restarted with backoff" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="328" y="517" width="230" height="17" as="geometry"/></mxCell>
        <mxCell id="c108" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0app" target="o0srv"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="765" as="sourcePoint"/><mxPoint x="90" y="440" as="targetPoint"/><Array as="points"><mxPoint x="65" y="765"/><mxPoint x="65" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="c109" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0srv" target="o0data"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="440" as="sourcePoint"/><mxPoint x="550" y="915" as="targetPoint"/><Array as="points"><mxPoint x="585" y="440"/><mxPoint x="585" y="915"/></Array></mxGeometry></mxCell>
        <mxCell id="o1g" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;macOS&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Apple Silicon and Intel]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="600" height="960" as="geometry"/></mxCell>
        <mxCell id="o1svc" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Launch agent&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[launchd · registered by the app via SMAppService]&lt;/i&gt;&lt;br&gt;Plist &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;net.decryptology.pitwall.service&lt;/span&gt; ships in the app bundle; KeepAlive restarts the server after a crash or an update.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="750" y="190" width="460" height="140" as="geometry"/></mxCell>
        <mxCell id="o1srv" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;pitwall-server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[runs as the logged-on user]&lt;/i&gt;&lt;br&gt;Inside the app bundle. Binds 127.0.0.1:11435; gets the login shell’s PATH for external engines.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="750" y="380" width="460" height="120" as="geometry"/></mxCell>
        <mxCell id="o1eng" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;llama-server children&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Metal or CPU build]&lt;/i&gt;&lt;br&gt;Scrubbed environment; killed with the server.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FDF3D9;strokeColor=#C98500;" vertex="1" parent="1"><mxGeometry x="750" y="550" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o1app" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitwall.app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri 2 · WKWebView · menu bar]&lt;/i&gt;&lt;br&gt;Window and menu-bar item. The window is rebuilt on Dock reopen.&lt;br&gt;A second launch focuses it.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#D4440D;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="750" y="710" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o1data" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;~/Library/Application Support/Pitwall&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[data folder]&lt;/i&gt;&lt;br&gt;settings.toml, apps.json, admin.key, models, engines&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="860" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o1inst" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;.dmg&lt;/b&gt;&lt;br&gt;ad-hoc sealed until a Developer ID exists&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="750" y="1000" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="c110" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1svc" target="o1srv"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="330" as="sourcePoint"/><mxPoint x="980" y="380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c111" value="Starts, restarts" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1028" y="347" width="104" height="17" as="geometry"/></mxCell>
        <mxCell id="c112" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1srv" target="o1eng"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="500" as="sourcePoint"/><mxPoint x="980" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c113" value="Child per hot model, restarted with backoff" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="988" y="517" width="230" height="17" as="geometry"/></mxCell>
        <mxCell id="c114" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1app" target="o1srv"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="765" as="sourcePoint"/><mxPoint x="750" y="440" as="targetPoint"/><Array as="points"><mxPoint x="725" y="765"/><mxPoint x="725" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="c115" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontSize=11;edgeStyle=none;rounded=0;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1srv" target="o1data"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="440" as="sourcePoint"/><mxPoint x="1210" y="915" as="targetPoint"/><Array as="points"><mxPoint x="1245" y="440"/><mxPoint x="1245" y="915"/></Array></mxGeometry></mxCell>
        <mxCell id="o2g" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Linux&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[x64 and arm64]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="600" height="960" as="geometry"/></mxCell>
        <mxCell id="o2svc" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;systemd user service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[~/.config/systemd/user/pitwall.service]&lt;/i&gt;&lt;br&gt;Written by &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pitwall-server install&lt;/span&gt;: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Restart=always&lt;/span&gt;, no administrator rights. Running without a login needs &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;loginctl enable-linger&lt;/span&gt;, the user’s choice.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1410" y="190" width="460" height="140" as="geometry"/></mxCell>
        <mxCell id="o2srv" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;pitwall-server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[runs as the user]&lt;/i&gt;&lt;br&gt;Binds 127.0.0.1:11435; gets the login shell’s PATH; restarts itself when its binary changed and it is idle.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="1410" y="380" width="460" height="120" as="geometry"/></mxCell>
        <mxCell id="o2eng" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;llama-server children&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[CPU, Vulkan or CUDA build]&lt;/i&gt;&lt;br&gt;Scrubbed environment; killed with the server.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FDF3D9;strokeColor=#C98500;" vertex="1" parent="1"><mxGeometry x="1410" y="550" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o2app" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitwall app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri 2 · WebKitGTK · appindicator]&lt;/i&gt;&lt;br&gt;Closing the window quits when the desktop has no tray.&lt;br&gt;A second launch focuses it.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#D4440D;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1410" y="710" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o2data" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;~/.local/share/pitwall&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[data folder]&lt;/i&gt;&lt;br&gt;XDG_DATA_HOME; settings.toml, apps.json, admin.key, models, engines&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1410" y="860" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="o2inst" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;.deb and AppImage&lt;/b&gt;&lt;br&gt;built by the release workflow; not run on a real desktop yet&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1410" y="1000" width="460" height="70" as="geometry"/></mxCell>
