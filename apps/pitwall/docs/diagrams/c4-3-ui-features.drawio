        <mxCell id="engines" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;engines&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[features/engines]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Builds, install with progress, self-test, version pin, roll back, features per build (supported, needs bNNNN).&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0072B2,#56B4E9);fillColor=light-dark(#E6F1F7,#1F303C);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="728" y="184" width="288" height="120" as="geometry"/></mxCell>
        <mxCell id="apps" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;apps&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[features/apps · features/usage]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Apps and keys, pairing approval, permissions and limits, per-app usage over time (the usage views), key shown once.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0072B2,#56B4E9);fillColor=light-dark(#E6F1F7,#1F303C);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="72" y="344" width="288" height="120" as="geometry"/></mxCell>
