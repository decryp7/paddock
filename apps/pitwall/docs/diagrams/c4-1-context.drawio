        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitwall — system context&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1620" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 1 — System context&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Who uses Pitwall and which outside systems it talks to. Nothing a user asks or a model answers leaves the machine; the only outbound traffic is downloads the user asked for (ADR 0001).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="966" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Machine owner&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;Installs engines and models, approves apps, watches memory and requests.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="apps" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Suite apps&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Software systems on this machine]&lt;/i&gt;&lt;br&gt;Debrief, Pitcrew, Spotter, Dyno: pair once, then ask for chat, embeddings and model choice.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="tools" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Other AI tools&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Software systems on this machine]&lt;/i&gt;&lt;br&gt;Anything that speaks the OpenAI, Anthropic or Ollama API: editors, SDK scripts, chat front ends.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="pw" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Pitwall&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Software system]&lt;/i&gt;&lt;br&gt;Local-only LLM server and manager: engines, model library, serving with memory management, per-app keys, three standard APIs plus /x/v1 on 127.0.0.1:11435.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="hf" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;Model search, file lists and GGUF downloads (allow-listed hosts, HTTPS).&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300" y="200" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="gh" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;GitHub releases&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;Pinned llama.cpp engine builds, SHA-256 checked.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300" y="371" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="os" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS service manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SCM · launchd · systemd]&lt;/i&gt;&lt;br&gt;Starts the server at login or boot and restarts it.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1300" y="560" width="380" height="110" as="geometry"/></mxCell>
