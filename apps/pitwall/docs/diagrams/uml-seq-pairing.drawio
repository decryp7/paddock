        <mxCell id="c29" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="124" y="653" as="sourcePoint"/><mxPoint x="436" y="653" as="targetPoint"/></mxGeometry></mxCell>
