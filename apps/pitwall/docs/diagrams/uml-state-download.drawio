        <mxCell id="q" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Queued&lt;/b&gt;&lt;br&gt;Accepted; URL parsed against the allow-list.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="dl" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Downloading&lt;/b&gt;&lt;br&gt;Bytes arrive (resumes from the .part file); SHA-256 checked at the end.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="240" height="100" as="geometry"/></mxCell>
