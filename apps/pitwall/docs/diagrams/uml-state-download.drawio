        <mxCell id="dni" value="" style="fontFamily=Arial,Helvetica,sans-serif;ellipse;fillColor=#17181C;strokeColor=#17181C;" vertex="1" parent="1"><mxGeometry x="1259" y="339" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="c104" value="&lt;b&gt;Done&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1290" y="340" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="ca" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cancelled&lt;/b&gt;&lt;br&gt;cancel_download; the partial file is kept for a later resume.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="240" height="90" as="geometry"/></mxCell>
