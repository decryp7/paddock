        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="1560" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitwall — containers&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1920" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 2 — Containers&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1920" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;The runnable units: the Tauri app (Angular UI, tray, Rust shell) in the user’s session, the windowless server that keeps serving when the window closes, and one engine process per loaded model (ADR 0002, 0004, 0010).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1660" y="1526" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="owner" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Machine owner&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;Uses the window and the tray menu.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="g_app" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;App process&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri 2 · logged-on user · shell in progress]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1000" height="400" as="geometry"/></mxCell>
        <mxCell id="ui" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Angular UI&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Angular 22 in the OS webview]&lt;/i&gt;&lt;br&gt;Dashboard, models, engines, apps, requests, playground, benchmarks, settings, tray view. SignalStores over a BACKEND token.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FBE9E1;strokeColor=#D4440D;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="tray" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Tray icon and menu&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src-tauri]&lt;/i&gt;&lt;br&gt;Loaded models, memory, queue, quick actions.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#2A78D6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="shell" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Rust shell&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src-tauri: Tauri commands]&lt;/i&gt;&lt;br&gt;Validates every UI argument, then calls the server’s management API with the admin key read from admin.key. One live-feed subscription forwards pushed updates to the UI and tray. Registers the server service; start at login.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#2A78D6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="490" height="320" as="geometry"/></mxCell>
        <mxCell id="g_srv" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Server process&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitwall-server · windowless · 127.0.0.1 only]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1320" height="470" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;pitwall-core&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Rust library, no I/O]&lt;/i&gt;&lt;br&gt;API formats, scheduler, memory policy, fit check, selection, keys, limits, privacy allow-list, packs, settings. Time is passed in.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#DFF4EB;strokeColor=#1BAF7A;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="loop" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;pitwall-loopback&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Rust library]&lt;/i&gt;&lt;br&gt;HTTP client whose port type can only mean 127.0.0.1.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#DFF4EB;strokeColor=#1BAF7A;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="srv" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;pitwall-server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Rust: axum, tokio; reqwest in egress only]&lt;/i&gt;&lt;br&gt;HTTP APIs and gate (Host, Origin, key), management API, serving core (queue, load, idle release), engines, model library, auth and pairing, OS service integration, the only outbound client.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="700" y="790" width="340" height="360" as="geometry"/></mxCell>
        <mxCell id="files" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Data folder&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[TOML, JSON, GGUF]&lt;/i&gt;&lt;br&gt;settings.toml, apps.json, admin.key, discovery.json, models/, engines/, packs/&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="810" width="190" height="230" as="geometry"/></mxCell>
        <mxCell id="eng" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Engine processes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[llama.cpp llama-server, or a pack engine]&lt;/i&gt;&lt;br&gt;One child per hot model on a random 127.0.0.1 port with a private key; scrubbed environment; killed with the server.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#FDF3D9;strokeColor=#C98500;" vertex="1" parent="1"><mxGeometry x="200" y="1290" width="540" height="130" as="geometry"/></mxCell>
        <mxCell id="clients" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Suite apps and API clients&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External software]&lt;/i&gt;&lt;br&gt;Debrief, Pitcrew, Spotter, Dyno and any OpenAI, Anthropic or Ollama-compatible tool.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="hf" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;Model search and GGUF files.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1500" y="800" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="gh" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;GitHub releases&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;llama.cpp builds and pack downloads.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1500" y="920" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="os" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS service manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SCM · launchd · systemd]&lt;/i&gt;&lt;br&gt;Starts and restarts the server.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#EFEFF2;strokeColor=#6B707C;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1500" y="1060" width="400" height="100" as="geometry"/></mxCell>
