        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;C4 · Level 3 — Components of pitwall-core&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1032" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Each API is parsed once into one neutral request and answered in its own family’s shape. Time and bytes come in as values (ADR 0002, 0003).&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1032" height="20" as="geometry"/></mxCell>
        <mxCell id="g" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;Wire formats and requests [pure, no I/O]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="144" width="1032" height="344" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;api&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[openai · anthropic · ollama]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Parse each API’s request once; write answers, stream chunks and errors in that family’s shape.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#007A5E,#2EC4A0);fillColor=light-dark(#E6F2EF,#193330);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="72" y="184" width="264" height="120" as="geometry"/></mxCell>
        <mxCell id="chat" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[neutral request]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;ChatRequest, ModelRef, ChatEvent, Usage: what every API maps to.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#007A5E,#2EC4A0);fillColor=light-dark(#E6F2EF,#193330);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="432" y="184" width="264" height="120" as="geometry"/></mxCell>
        <mxCell id="llama" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;llama&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[llama-server protocol]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Launch arguments, parallel slots, the /v1/chat/completions body and /props parsing.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#007A5E,#2EC4A0);fillColor=light-dark(#E6F2EF,#193330);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="792" y="184" width="264" height="120" as="geometry"/></mxCell>
