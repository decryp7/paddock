        <mxCell id="c26" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="509" width="1494" height="112" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;loop&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="40" height="18" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[for each action on an idle model]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="515" width="1430" height="18" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;span style=&quot;font-size:12px&quot;&gt;Rules in order: busy or loading models are never released; pressure releases least recently used first; then idle time; then deep idle; yield shortens idle times while a full-screen app runs. Half way to idle the context is cleared and the weights stay.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="428" y="629" width="440" height="88" as="geometry"/></mxCell>
