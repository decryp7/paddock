        <mxCell id="c119" value="Rules in order: busy or loading models are never released; pressure releases least recently used first; then the idle time; then deep idle; yield shortens idle times while a full-screen app runs." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFF9E0;strokeColor=#C98500;strokeWidth=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="518" y="682" width="640" height="60" as="geometry"/></mxCell>
