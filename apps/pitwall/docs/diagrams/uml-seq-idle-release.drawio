        <mxCell id="c27" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;loop&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="40" height="18" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[for each Unload action on an idle model]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="515" width="1428" height="18" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;sample(hot models, per-app share)&lt;/span&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="350" y="629" width="265" height="16" as="geometry"/></mxCell>
        <mxCell id="c30" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="342" y="654" as="sourcePoint"/><mxPoint x="1432" y="654" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c31" value="&lt;span style=&quot;font-size:12px&quot;&gt;Rules in order: busy or loading models are never released; pressure releases least recently used first; then idle time; then deep idle; yield shortens idle times while a full-screen app runs. Half way to idle the context is cleared and the weights stay.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="340" y="670" width="440" height="88" as="geometry"/></mxCell>
