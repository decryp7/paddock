        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="1400" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;pitwall-server — components&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1820" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 3 — Components of pitwall-server&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;The thin edge: sockets, processes and files. Every decision comes from pitwall-core. Outbound HTTP exists only in egress, and engines are started only through process (ADR 0001, 0002, 0004).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="c103" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitwall · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1560" y="1366" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="http" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;http&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[axum router]&lt;/i&gt;&lt;br&gt;The three standard APIs and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;/x/v1&lt;/span&gt; (health, pair, select, models, tasks, tokens, jobs); the gate checks Host, Origin and key; provenance headers; SSE and NDJSON out.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="mgmt" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;mgmt&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[/mgmt/v1]&lt;/i&gt;&lt;br&gt;One JSON call per UI method, the live feed and the playground stream; admin key only.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[AppState]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;AppState::open&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;start_chat&lt;/span&gt; (authorize, limits, queue, load, generate), the background tasks, the request recorder, discovery file.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="1700" height="140" as="geometry"/></mxCell>
        <mxCell id="lib" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;library&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[models]&lt;/i&gt;&lt;br&gt;Scans GGUF files, Hugging Face search, resumable verified downloads, delete, fit and capabilities.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="srv" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;serving&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[queue, load, release]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Serving&lt;/span&gt;: acquire a turn, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ensure&lt;/span&gt; a hot model, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;tick&lt;/span&gt; idle release every 5 s, chat and embed on the engine, cancel.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="auth" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;auth&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[apps.json]&lt;/i&gt;&lt;br&gt;Apps, hashed keys, pairing requests, admin key file, per-app rate window.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="940" y="590" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="sys" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;system&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[probes]&lt;/i&gt;&lt;br&gt;Detects hardware; reads RAM, GPU and disk; resident size of engines.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="1380" y="590" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="eng" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;engines&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Engine&lt;/span&gt; trait]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;LlamaCpp&lt;/span&gt; install (checksum, unpack, self-test, roll back) and start; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Planned&lt;/span&gt; engines say why not.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="500" y="810" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="proc" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;process&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[only place that spawns]&lt;/i&gt;&lt;br&gt;Scrubbed environment, no console window, killed on drop.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="940" y="810" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="svc" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[service/spec and friends]&lt;/i&gt;&lt;br&gt;Per-OS service names and paths, systemd unit, Windows service wrapper, restart after an update.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="1380" y="810" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="egress" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;egress&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[the only HTTP client]&lt;/i&gt;&lt;br&gt;Allow-listed HTTPS, redirects re-checked, resume, SHA-256, offline switch.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="pack" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;pack_engine&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[ADR 0011]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PackEngine&lt;/span&gt;: runs any engine pack through the generic launch, health and install path.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="500" y="1030" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="paths" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;paths&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[data folder]&lt;/i&gt;&lt;br&gt;Per-OS data folder, atomic writes with backup, tolerant reads.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fillColor=#E4EEFA;strokeColor=#2A78D6;" vertex="1" parent="1"><mxGeometry x="1380" y="1030" width="380" height="140" as="geometry"/></mxCell>
