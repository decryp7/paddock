{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Pitcrew",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
