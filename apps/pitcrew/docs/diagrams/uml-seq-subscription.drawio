        <mxCell id="c68" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[the connection is lost]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="1208" width="1128" height="18" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;span style=&quot;font-size:12px&quot;&gt;A service with another protocol version answers &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;ProtocolMismatch&lt;/span&gt; and the UI says to install the same Pitcrew version for both. Commands such as Start still work over their own short connections.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="748" y="1499" width="360" height="88" as="geometry"/></mxCell>
