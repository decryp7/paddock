        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="1560" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitcrew — containers&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 2 — Containers&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;The runnable units: the Tauri app (Angular UI, Rust shell, tray) in the user's session, the Pitcrew service that owns the runners, the runner processes it starts, and the files it keeps. The app can be closed or crash without touching the runners (ADR 0001, 0003, 0004).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitcrew · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1660" y="1526" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Build-machine owner&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;Uses the window and the tray menu.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FBE9E1;strokeColor=#D4440D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="154" width="300" height="126" as="geometry"/></mxCell>
        <mxCell id="c16" value="" style="ellipse;strokeWidth=1.5;strokeColor=#D4440D;fillColor=#FBE9E1;" vertex="1" parent="1"><mxGeometry x="190.0" y="110" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="g_app" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;App process&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri 2 · logged-on user]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1280" height="420" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Angular UI&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Angular 22 in the OS webview]&lt;/i&gt;&lt;br&gt;Dashboard, runners, activity, logs, updates, settings, register wizard. SignalStores over a BACKEND token.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FBE9E1;strokeColor=#D4440D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Tray icon and menu&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[tray.rs]&lt;/i&gt;&lt;br&gt;Worst state of all runners, per-runner menu, quick actions.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="570" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Rust shell&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[app/src-tauri: Tauri commands]&lt;/i&gt;&lt;br&gt;Validates every UI argument, then asks the service through the ServiceClient trait. Runs one subscription thread (events.rs) that forwards pushed events to the UI and tray and shows notifications. Also: credential store, Gitea API client, diagnostics bundle, service install, Pitcrew updater.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="420" height="330" as="geometry"/></mxCell>
        <mxCell id="g_svc" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Service process&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[launch agent · Windows service · systemd (in progress)]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1280" height="320" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;pitcrew-core&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Rust library, no I/O]&lt;/i&gt;&lt;br&gt;Controller, watchdog, update machine, housekeeping, history, metrics, config, protocol. Time is passed in.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="850" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Pitcrew service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitcrew-service: Rust]&lt;/i&gt;&lt;br&gt;One supervisor thread owns every runner; an async IPC server answers the app; worker threads do downloads, swaps and cleanups.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="850" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;State files&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[TOML, JSON, log files]&lt;/i&gt;&lt;br&gt;pitcrew.toml, state.json, service and runner logs.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="930" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Runner processes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[gitea-runner, one per runner]&lt;/i&gt;&lt;br&gt;Children of the service, each in its own folder; job processes are their children.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FDF3D9;strokeColor=#C98500;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1230" width="420" height="140" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Gitea / Forgejo server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;Gives runners their jobs; job outcomes via the API.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1440" y="640" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Pitcrew releases&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;latest.json and signed installers.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1440" y="380" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS credential store&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Credential Manager · Keychain · Secret Service]&lt;/i&gt;&lt;br&gt;Gitea read token, remembered registration tokens.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1440" y="510" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Runner release hosts&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[dl.gitea.com · gitea.com]&lt;/i&gt;&lt;br&gt;Version, binary, SHA-256 checksums.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1440" y="840" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS service manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SCM · launchd · systemd (planned)]&lt;/i&gt;&lt;br&gt;Starts the service; the app registers it with the OS's own prompt.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1440" y="1100" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="c29" value="Uses the window" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" value="Commands and events&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri IPC]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.23;exitDx=0;exitDy=0;entryX=0;entryY=0.23;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c31" value="Updates icon and menu&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[tray API]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.77;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c32" value="Requests; subscribes to status events&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[named pipe / Unix socket; length-prefixed JSON]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c33" value="Asks for decisions&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[function calls]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c34" value="Reads and writes atomically&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[files]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" value="Starts, signals, reads output&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[child processes, pipes]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c36" value="Checks, downloads, verifies&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[HTTPS]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="Starts and restarts&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SCM · SMAppService · systemd]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="856" y="1150"/></Array></mxGeometry></mxCell>
        <mxCell id="c38" value="Checks for Pitcrew updates (opt-in)&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[HTTPS]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.106;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="Stores and reads tokens&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS credential API]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
