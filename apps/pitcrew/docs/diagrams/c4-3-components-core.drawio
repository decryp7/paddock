<mxfile host="drawio" agent="Pitcrew diagram generator" version="24.7.17" compressed="false">
  <diagram id="Pitcrew — core components" name="Pitcrew — core components">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2240" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2240" height="1500" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitcrew — core components&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 3 — Components of pitcrew-core&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Everything the service decides with, as pure functions and state machines: no I/O, no clock (time comes in as &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Timestamp&lt;/span&gt; values), no OS. The service feeds events in and carries out the returned actions (ADR 0001, 0002, 0006, 0007).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1400" height="18" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitcrew · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1900" y="1466" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Supervision of one runner&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[controller and its rules]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1100" height="570" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Log classifier&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[logline.rs]&lt;/i&gt;&lt;br&gt;Turns each runner log line into a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RunnerLogEvent&lt;/span&gt;: declared, fetch timed out, task started, not registered.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Job tracker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[jobs.rs]&lt;/i&gt;&lt;br&gt;A job runs while its processes do, plus 20 s grace; reads repository, job and run from task-started lines.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Session rules&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[session.rs]&lt;/i&gt;&lt;br&gt;Where a runner may start: user's session, service session, or wait for log-on; when to relocate.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="190" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Watchdog&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[watchdog.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;StallDetector&lt;/span&gt;: at least 6 timed-out polls in 15 minutes while no job runs means stalled.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[controller.rs]&lt;/i&gt;&lt;br&gt;One runner's life: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Input&lt;/span&gt; in, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Action&lt;/span&gt;s out. Stop, restart, drain and stall restarts wait for the job to end.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="380" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Restart policy&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[restart.rs]&lt;/i&gt;&lt;br&gt;Back-off 10 s doubling to 5 min, reset after 10 min; crash loop after 5 exits in 10 min.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="380" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Health&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[health.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RunnerStatus&lt;/span&gt;: one word from the facts (Idle, Busy, Draining, Stalled, CrashLoop, Updating).&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="c23" value="Events" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="Job?" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="Log-on" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="Timeouts" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="On exit" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c28" value="Facts" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c29" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Updates&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[ADR 0002]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="1010" height="570" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Release locations&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[distribution.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RunnerKind&lt;/span&gt;: where each kind publishes versions, binaries, checksums and signatures.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="190" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Checksums&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[checksum.rs]&lt;/i&gt;&lt;br&gt;Parses checksum files; SHA-256 verify; two hosts must agree.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1580" y="190" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Versions&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[version.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RunnerVersion&lt;/span&gt;: parsed once, ordered, never a bare string.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1930" y="190" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Update policy&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[update/policy.rs]&lt;/i&gt;&lt;br&gt;Automatic, notify only or manual; window; channel; pin and skip; decides apply, available or wait.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Update machine&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[update/machine.rs]&lt;/i&gt;&lt;br&gt;Downloading, Verifying, Draining, Stopping, Swapping, Confirming, RollingBack: commands out, outcome at the end.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1580" y="380" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Outcomes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[update/machine.rs]&lt;/i&gt;&lt;br&gt;Updated, RolledBack, Postponed, Cancelled, Failed; kept as the last update.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1930" y="380" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c36" value="URLs" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="Begin" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="Finish" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="Verified or failed" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c40" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Housekeeping and metrics&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[ADR 0006, 0007]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="300" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Housekeeping&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[housekeeping.rs]&lt;/i&gt;&lt;br&gt;Plans a cleanup from a folder scan and a policy: work folders, caches, old binaries, rotated logs.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Runner usage&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[usage.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;tree_members&lt;/span&gt;: the runner and everything it started; CPU share from cumulative CPU time; bounded.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="810" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Metrics&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[metrics.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;MachineSample&lt;/span&gt; and tiered stores: raw, 5-minute and hourly buckets; folder-size series.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="810" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="c44" value="Points" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c45" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Records and configuration&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[versioned, tolerant of damage]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1200" y="760" width="1010" height="300" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Configuration&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[config.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pitcrew.toml&lt;/span&gt;: schema version, defaults, runners; migration; a bad entry is skipped, a bad file falls back to the backup.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="810" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;History&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[history.rs]&lt;/i&gt;&lt;br&gt;Bounded event list; summaries per local day: uptime, restarts, jobs, marks and spans.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1580" y="810" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Service state&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[state.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;state.json&lt;/span&gt;: per runner history, last update, usage and folder sizes; versioned.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1930" y="810" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="c49" value="Part of" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c50" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Wire and helpers&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[shared with the app]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="2160" height="250" as="geometry"/></mxCell>
        <mxCell id="c51" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Protocol&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[protocol.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Request&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Response&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ServiceEvent&lt;/span&gt;; framing; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;MAX_FRAME&lt;/span&gt;; a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Secret&lt;/span&gt; that never prints.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1170" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Names&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[names.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RunnerName&lt;/span&gt;: refuses path characters and length.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="1170" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Runner layout&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[layout.rs]&lt;/i&gt;&lt;br&gt;Folder layout and register arguments for a runner kind.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="1170" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Log lines&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[logs.rs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;LogLine&lt;/span&gt;, bounded plain-text search, no user patterns.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="1170" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[notify.rs]&lt;/i&gt;&lt;br&gt;What the user is told, on transitions only, and the words.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="1170" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c56" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Redaction&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[redact.rs]&lt;/i&gt;&lt;br&gt;Masks tokens and secrets in anything that leaves the service.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="1170" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c57" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Gitea API&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[gitea_api.rs]&lt;/i&gt;&lt;br&gt;URLs and parsing for job outcomes; the app does the HTTP.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#DFF4EB;strokeColor=#1BAF7A;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1750" y="1170" width="250" height="150" as="geometry"/></mxCell>
