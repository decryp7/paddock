<mxfile host="drawio" agent="Pitcrew diagram generator" version="24.7.17" compressed="false">
  <diagram id="Pitcrew — system context" name="Pitcrew — system context">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2060" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2060" height="1000" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitcrew — system context&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 1 — System context&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Who uses Pitcrew and which outside systems it talks to. Pitcrew keeps CI runners for Gitea and Forgejo going on a build machine; the network is used only to reach the server, to fetch runner releases and, when the user opts in, Pitcrew updates.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1400" height="18" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitcrew · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1720" y="966" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Build-machine owner&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;Registers runners, watches the dashboard and tray, drains a runner for maintenance, approves updates.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FBE9E1;strokeColor=#D4440D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="174" width="300" height="126" as="geometry"/></mxCell>
        <mxCell id="c16" value="" style="ellipse;strokeWidth=1.5;strokeColor=#D4440D;fillColor=#FBE9E1;" vertex="1" parent="1"><mxGeometry x="970.0" y="130" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:18px&quot;&gt;Pitcrew&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Software system: Tauri app + background service + Rust core]&lt;/i&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="400" width="580" height="400" as="geometry"/></mxCell>
        <mxCell id="c18" value="Keeps the runners running: starts them, restarts one that crashed or stalled (with back-off and crash-loop protection), updates them between jobs with roll-back, cleans their disk and shows it all in a dashboard and a tray icon.&lt;br&gt;&lt;br&gt;Runs on Windows, macOS and Linux. The service keeps supervising when the window is closed or the app crashes." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#555A65;fontSize=12;text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="750" y="500" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Gitea / Forgejo server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[External system]&lt;/i&gt;&lt;br&gt;Runners register with it and poll it for jobs; the app reads job outcomes with a read-only token.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1640" y="398" width="380" height="84" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Runner release hosts&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[dl.gitea.com · gitea.com releases]&lt;/i&gt;&lt;br&gt;Latest runner version, binaries and SHA-256 checksums; two hosts must agree.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1640" y="498" width="380" height="84" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Pitcrew releases&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Gitea release of Pitcrew (opt-in)]&lt;/i&gt;&lt;br&gt;latest.json and signed installers for Pitcrew's own updates.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1640" y="598" width="380" height="84" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS service manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Windows SCM · macOS launchd · Linux systemd (user)]&lt;/i&gt;&lt;br&gt;Starts the Pitcrew service at boot or log-in and restarts it if it fails.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS credential store&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Credential Manager · Keychain · Secret Service]&lt;/i&gt;&lt;br&gt;Holds the Gitea read token and, if asked, registration tokens.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="c24" value="Registers, watches and controls runners&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[GUI, tray menu, notifications]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="Registers runners; reads job outcomes&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[HTTPS; read-only token]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="Checks, downloads, verifies&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[HTTPS; SHA-256 from two hosts]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="Checks for Pitcrew updates&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[HTTPS; minisign]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c28" value="Registers the service with&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SCM · SMAppService · systemctl --user]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c29" value="Stores and reads tokens&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS credential API]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#E5E5EA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="780" height="62" as="geometry"/></mxCell>
