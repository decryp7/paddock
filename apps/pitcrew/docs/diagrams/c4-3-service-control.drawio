        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Pitcrew — service: control path&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1248" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;C4 · Level 3 — Components of pitcrew-service&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1248" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;How the service starts, how the app reaches it, and where it asks the core for decisions. The thin edge around the pure core.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1248" height="20" as="geometry"/></mxCell>
        <mxCell id="g" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;Service process&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="376" y="144" width="1000" height="360" as="geometry"/></mxCell>
        <mxCell id="cli" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Command line&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[cli.rs, main.rs]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;run, install, uninstall, status, check-config; parsed once into a typed command.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#BF3A0C,#FF7A45);fillColor=light-dark(#F9EBE7,#3A2722);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="400" y="184" width="248" height="120" as="geometry"/></mxCell>
        <mxCell id="host" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Host&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[host.rs]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Starts the supervisor and the IPC server; restarts the service when its own program changed.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#BF3A0C,#FF7A45);fillColor=light-dark(#F9EBE7,#3A2722);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="752" y="184" width="248" height="120" as="geometry"/></mxCell>
        <mxCell id="plat" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Platform adapters&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[platform/]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Windows SCM entry; macOS launch agent; Linux systemd user unit.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#BF3A0C,#FF7A45);fillColor=light-dark(#F9EBE7,#3A2722);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1104" y="184" width="248" height="120" as="geometry"/></mxCell>
        <mxCell id="shell" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;App shell&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[separate process]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Sends requests, subscribes to events.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#4C5BD4,#8FA3FF);fillColor=light-dark(#EDEFFB,#292D3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="48" y="360" width="224" height="120" as="geometry"/></mxCell>
        <mxCell id="ipc" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;IPC server&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[ipc.rs]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Named pipe with ACL or 0600 Unix socket; hello first; frames bounded; 32 connections at most.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#BF3A0C,#FF7A45);fillColor=light-dark(#F9EBE7,#3A2722);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="248" height="120" as="geometry"/></mxCell>
        <mxCell id="sup" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Supervisor&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[supervisor.rs]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;One thread, one channel of messages; see the next diagram.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#BF3A0C,#FF7A45);fillColor=light-dark(#F9EBE7,#3A2722);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="752" y="360" width="248" height="120" as="geometry"/></mxCell>
