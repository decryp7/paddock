        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2400" height="1400" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pitcrew — deployment&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · Deployment diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Where each part runs on a build machine, per OS. The service is the long-lived process (a Windows service, a launch agent, a systemd unit); the app is the user's window and tray; runners are children of the service. &lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1400" height="18" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitcrew · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2060" y="1366" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="bm" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Build machines&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[one Pitcrew installation per machine]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=none;strokeColor=#555A65;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="2360" height="750" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Windows build machine&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Windows 10 / 11]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cube;size=16;darkOpacity=0.05;strokeWidth=1.5;strokeColor=#6B707C;fillColor=#F7F7F9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="720" height="640" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitcrew app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Pitcrew.exe: Tauri + WebView2]&lt;/i&gt;&lt;br&gt;Window and notification-area icon; runs as the logged-on user; installed by the NSIS setup.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="235" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Credential Manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS]&lt;/i&gt;&lt;br&gt;Gitea read token and remembered registration tokens.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="430" y="235" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitcrew service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitcrew-service.exe: Windows service, LocalSystem]&lt;/i&gt;&lt;br&gt;Automatic (delayed) start; recovery restarts after 10 s, 60 s, 5 min.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="425" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Service Control Manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS]&lt;/i&gt;&lt;br&gt;Registered by the app through a UAC prompt.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="430" y="450" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Runner processes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[gitea-runner.exe]&lt;/i&gt;&lt;br&gt;In the logged-on user's session by default (desktop jobs work) or in session 0.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FDF3D9;strokeColor=#C98500;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="615" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Data folder&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[%ProgramData%\Pitcrew]&lt;/i&gt;&lt;br&gt;pitcrew.toml, state.json, logs; administrators write.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="430" y="615" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="c22" value="Requests and events&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[named pipe \\.\pipe\pitcrew, ACL]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c23" value="Stores tokens" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="Starts, restarts" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="Starts, signals" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="Reads, writes" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="&lt;b style=&quot;font-size:14px&quot;&gt;macOS build machine&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[macOS 13 or newer]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cube;size=16;darkOpacity=0.05;strokeWidth=1.5;strokeColor=#6B707C;fillColor=#F7F7F9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="840" y="175" width="720" height="640" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitcrew app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Pitcrew.app: Tauri + WKWebView]&lt;/i&gt;&lt;br&gt;Window and menu-bar icon; runs as the user; ad-hoc signed, not notarised.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="235" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Keychain&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS]&lt;/i&gt;&lt;br&gt;Gitea read token and remembered registration tokens.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1230" y="235" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitcrew service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitcrew-service run: user launch agent]&lt;/i&gt;&lt;br&gt;Label net.decryptology.pitcrew.service; RunAtLoad, KeepAlive; runners get the login shell's PATH.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="425" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;launchd&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS, SMAppService]&lt;/i&gt;&lt;br&gt;The user approves the agent under Login Items; no administrator rights.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1230" y="450" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Runner processes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[gitea-runner]&lt;/i&gt;&lt;br&gt;Children of the agent in the user's GUI session: keychain, Xcode and simulators work.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FDF3D9;strokeColor=#C98500;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="615" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Data folder&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[~/Library/Application Support/Pitcrew]&lt;/i&gt;&lt;br&gt;pitcrew.toml, state.json, pitcrew.sock (0600); logs in ~/Library/Logs/Pitcrew.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="615" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="c34" value="Requests and events&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Unix socket, mode 0600]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" value="Stores tokens" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c36" value="Starts, restarts" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="Starts, signals" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="Reads, writes" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="&lt;b style=&quot;font-size:14px&quot;&gt;Linux build machine&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[x86-64 or ARM64 with systemd]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cube;size=16;darkOpacity=0.05;strokeWidth=1.5;strokeColor=#6B707C;fillColor=#F7F7F9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1640" y="175" width="720" height="640" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitcrew app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri + WebKitGTK; .deb or AppImage]&lt;/i&gt;&lt;br&gt;Window and status-notifier tray icon; with no tray, closing the window quits the app.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="235" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Secret Service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS]&lt;/i&gt;&lt;br&gt;Gitea read token and remembered registration tokens.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2030" y="235" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitcrew service&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[pitcrew-service run: systemd user service]&lt;/i&gt;&lt;br&gt;~/.config/systemd/user/pitcrew.service; Restart=always, KillMode=mixed; no root.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="425" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;systemd (user)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[OS]&lt;/i&gt;&lt;br&gt;Enabled with systemctl --user; loginctl enable-linger keeps it running when logged out.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EFEFF2;strokeColor=#6B707C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2030" y="450" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Runner processes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[gitea-runner]&lt;/i&gt;&lt;br&gt;Children of the service in the user's session, with the login shell's PATH.&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FDF3D9;strokeColor=#C98500;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1670" y="615" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Data folder&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[~/.local/share/Pitcrew]&lt;/i&gt;&lt;br&gt;pitcrew.toml, state.json, logs; socket in $XDG_RUNTIME_DIR/pitcrew (0600).&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.5;strokeColor=#2A78D6;fillColor=#E4EEFA;align=center;verticalAlign=middle;spacingTop=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="2030" y="615" width="300" height="140" as="geometry"/></mxCell>
