        <mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Stall detection and restart&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · Sequence diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;A runner can stay alive while its polls for tasks keep timing out. At least six timed-out polls within 15 minutes while no job runs is a stall: the runner is stopped gracefully and restarted with back-off. A running job always wins (ADR 0006).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1400" height="18" as="geometry"/></mxCell>
