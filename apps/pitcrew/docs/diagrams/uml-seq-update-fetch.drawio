        <mxCell id="c46" value="&lt;span style=&quot;font-size:12px&quot;&gt;Continues in “Safe update: swap, restart, confirm”. A failed download or verification ends the update as Failed; the installed binary is untouched.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="210" y="1032" width="380" height="72" as="geometry"/></mxCell>
