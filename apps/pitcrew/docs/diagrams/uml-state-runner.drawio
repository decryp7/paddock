        <mxCell id="c31" value="no user logged on: wait&lt;br&gt;user logs on / Launch" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;startArrow=block;startFill=1;startSize=7;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c32" value="[fewer exits]  RestartAt" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c33" value="[5 exits in 10 min]" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c34" value="cool-down over, or a manual Start" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.92;exitY=1;exitDx=0;exitDy=0;entryX=0.17;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" value="exits by itself (also: launch failed)" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="140"/><mxPoint x="280" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="c36" value="Stop · Restart · Drain · Relocate while a job runs" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="Resume: pending cleared" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="480"/><mxPoint x="1325" y="480"/></Array></mxGeometry></mxCell>
        <mxCell id="c38" value="same request, no job running · stall found · update StopNow / StopGracefully" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.135;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="the job ended / StopGracefully" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.951;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c40" value="exited, then Stop" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.125;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c41" value="exited, then Pause (drain done)" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c42" value="exited, then Hold" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.875;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c43" value="exited, then Restart · Relocate / Launch" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c44" value="exited, then StallRestart" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="822"/><mxPoint x="30" y="215"/></Array></mxGeometry></mxCell>
        <mxCell id="c45" value="Start / Launch" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="1110"/><mxPoint x="776" y="1110"/></Array></mxGeometry></mxCell>
        <mxCell id="c46" value="Resume / Launch" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="1150"/><mxPoint x="740" y="1150"/></Array></mxGeometry></mxCell>
        <mxCell id="c47" value="Hold(false) · LaunchNow / Launch" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#17181C;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#555A65;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.33;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1800" y="1190"/><mxPoint x="699" y="1190"/></Array></mxGeometry></mxCell>
        <mxCell id="c48" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Controller::new&lt;/span&gt; starts in WaitingToStart (wanted), Stopped or Paused from the saved state. Start clears a crash loop and a pause. A launch that fails is treated like an exit: it goes through the same restart decision. Stop, Pause and Restart on a runner that is not running take effect at once." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;shape=note;size=12;fillColor=#FFFFFF;strokeColor=#555A65;strokeWidth=1;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="600" height="150" as="geometry"/></mxCell>
