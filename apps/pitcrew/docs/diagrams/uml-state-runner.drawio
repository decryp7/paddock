        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2300" height="1400" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:20px&quot;&gt;Runner lifecycle&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · State machine diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;One runner's life as the pure &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Controller&lt;/span&gt; in &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pitcrew-core&lt;/span&gt; (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Life&lt;/span&gt;). Stop, restart, drain, a stall restart and an update all wait until no job runs; the process is terminated only after the stop timeout, and only while no job runs (ADR 0001, 0003, 0006).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1400" height="18" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Pitcrew · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1960" y="1366" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="ellipse;fillColor=#17181C;strokeColor=#17181C;" vertex="1" parent="1"><mxGeometry x="61" y="358" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;WaitingToStart&lt;/b&gt;&lt;br&gt;{ at }: back-off 10 s doubling to 5 min, reset after 10 min running&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="160" y="320" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Starting&lt;/b&gt;&lt;br&gt;entry: Launch; the launcher spawns the process&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="rhombus;strokeWidth=1.5;strokeColor=#17181C;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="265" y="200" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;CrashLoop&lt;/b&gt;&lt;br&gt;{ until }: 5 exits in 10 min pause restarts for 30 min&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="170" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;WaitingForLogon&lt;/b&gt;&lt;br&gt;interactive runner on Windows; nobody is logged on&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Running  (process alive)&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F7FAFE;strokeColor=#2A78D6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="800" height="300" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Running { since }&lt;/b&gt;&lt;br&gt;stall detector watches; job tracker decides when a job runs&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="315" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Draining (status)&lt;/b&gt;&lt;br&gt;a request is pending; finish the job, take no more&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1640" y="315" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Stopping { then, killed }&lt;/b&gt;&lt;br&gt;graceful stop (SIGTERM · Ctrl+Break); after 120 s with no job running the process tree is killed&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="740" width="800" height="110" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Stopped&lt;/b&gt;&lt;br&gt;the user stopped it&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="1000" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Paused&lt;/b&gt;&lt;br&gt;drained for maintenance&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1000" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Held&lt;/b&gt;&lt;br&gt;an update has taken over&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E4EEFA;strokeColor=#2A78D6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="1000" width="200" height="80" as="geometry"/></mxCell>
