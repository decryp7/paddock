# Generated by paddock-service from the app's ServiceSpec; do not edit, change the spec instead.
[Unit]
Description=Dyno helper
Documentation=https://dev.decryptology.net/decryp7/dyno

[Service]
Type=simple
ExecStart="/usr/bin/dyno-helper" "serve"
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_NET_ADMIN
SystemCallFilter=@system-service
SystemCallFilter=~@mount
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
StateDirectory=dyno-helper
StateDirectoryMode=0700
ExecStopPost=-+/usr/bin/rmdir /var/lib/dyno-helper
RuntimeDirectory=dyno-helper
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
