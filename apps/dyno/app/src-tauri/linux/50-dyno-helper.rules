// Dyno's helper (ADR 0027): the one thing this rule allows is starting the helper's own unit, from a local, active session,
// so the card's "Start" needs no password. Enabling, stopping and every other unit stay behind the usual authentication.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "dyno-helper.service" &&
      action.lookup("verb") == "start" &&
      subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
