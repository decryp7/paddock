<mxfile host="drawio" agent="Dyno diagram generator" version="24.7.17" compressed="false">
  <diagram id="Window lifecycle" name="Window lifecycle">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="760" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="760" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Window lifecycle&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · State machine diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Closing the window destroys it (a hidden WebKit view can come back blank); the tray and the agent stay. Opening builds a fresh window from the saved configuration. With no tray (some Linux desktops) closing quits. Quitting the app never stops the agent (ADR 0001, 0009; docs/suite-lessons.md).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="32" as="geometry"/></mxCell>
        <mxCell id="i" value="" style="ellipse;fillColor=#1B2130;strokeColor=#1B2130;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Starting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;splash in index.html; no IPC awaited before first paint&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="open" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Window open&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;Angular UI live, subscribed to pushes&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="tray" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Closed to tray&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;no window, no webview; tray and agent running&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="quit" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Quitting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;unsubscribe, exit the app&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="430" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="f" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#1B2130;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1330" y="457" width="26" height="26" as="geometry"/></mxCell><mxCell id="f_i" value="" style="ellipse;fillColor=#1B2130;strokeColor=#1B2130;" vertex="1" parent="1"><mxGeometry x="1336" y="463" width="14" height="14" as="geometry"/></mxCell>
        <mxCell id="c103" value="launch" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i" target="start"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c104" value="first paint" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c105" value="close, tray present" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="open" target="tray"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="170"/></Array></mxGeometry></mxCell>
        <mxCell id="c106" value="tray “Open”, Dock reopen: rebuild" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0;exitY=0.8;entryX=0.8;entryY=0;" edge="1" parent="1" source="tray" target="open"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="194"/></Array></mxGeometry></mxCell>
        <mxCell id="c107" value="close without a tray, or Quit" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="open" target="quit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="c108" value="Quit" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tray" target="quit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c109" value="" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="quit" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c110" value="&lt;span style=&quot;font-size:11px&quot;&gt;Every backend request has a timeout and an inline error with Retry; initialisers start work in the background and return, so a reopened window is never blank for good. The agent keeps sampling and keeps rules applied after the app exits.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=0;fillColor=#FFFBE6;strokeColor=#C9B458;strokeWidth=1;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="560" width="980" height="70" as="geometry"/></mxCell>
        <mxCell id="c111" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Legend&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="200" height="16" as="geometry"/></mxCell>
        <mxCell id="c112" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="672" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c113" value="&lt;span style=&quot;font-size:11px&quot;&gt;State&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="98" y="673" width="420" height="16" as="geometry"/></mxCell>
