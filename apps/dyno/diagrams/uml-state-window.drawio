        <mxCell id="c26" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Event&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="201" y="763" width="41" height="18" as="geometry"/></mxCell>
