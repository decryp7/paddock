        <mxCell id="c108" value="Puts points" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="rollup" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="440"/><mxPoint x="1190" y="340"/><mxPoint x="1390" y="340"/></Array></mxGeometry></mxCell>
        <mxCell id="c109" value="Push" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sampler" target="server"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
