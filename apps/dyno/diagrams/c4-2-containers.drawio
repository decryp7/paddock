        <mxCell id="c117" value="&lt;span style=&quot;font-size:11px&quot;&gt;Dyno container or library&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="98" y="925" width="420" height="16" as="geometry"/></mxCell>
