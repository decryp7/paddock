        <mxCell id="c110" value="Calls&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[dyno-ipc]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent" target="plugins"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="278"/><mxPoint x="1400" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="c111" value="HelperAction&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[dyno-ipc, token, peer pid]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent" target="helper"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="294"/><mxPoint x="1370" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="c112" value="Update check&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[HTTPS, opt-in]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="shell" target="upd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
