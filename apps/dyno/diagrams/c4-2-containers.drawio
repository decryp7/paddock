        <mxCell id="c115" value="&lt;span style=&quot;font-size:11px&quot;&gt;Angular UI and people&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="98" y="903" width="420" height="16" as="geometry"/></mxCell>
