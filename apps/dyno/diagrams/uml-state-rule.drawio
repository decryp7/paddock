        <mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3009;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rel" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1284" y="592"/><mxPoint x="161" y="592"/></Array></mxGeometry></mxCell>
        <mxCell id="c29" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Undo all (reverse order)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="497" y="598" width="155" height="18" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;span style=&quot;font-size:12px&quot;&gt;Undo all also runs when the rule is disabled or paused, another profile is chosen, the context turns false or the app comes to the front. A process that joins while Acting gets the steps already taken. Steps are LowerPriority, EfficiencyMode, CpuCap(percent) and Notify; Notify has no inverse.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="96" y="648" width="1296" height="56" as="geometry"/></mxCell>
