<mxfile host="drawio" agent="Dyno diagram generator" version="24.7.17" compressed="false">
  <diagram id="Rule engine per (rule, app)" name="Rule engine per (rule, app)">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="1000" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Rule engine per (rule, app)&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · State machine diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;One small state machine per rule and application, fed a tick at a time (dyno_core::rules::Engine). Steps add up and are undone in reverse order; protected processes and the foreground app are never touched (ADR 0004).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="32" as="geometry"/></mxCell>
        <mxCell id="i" value="" style="ellipse;fillColor=#1B2130;strokeColor=#1B2130;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="idle" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Idle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;rule does not apply or app below threshold&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="310" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="watch" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Watching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;above threshold since t&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="act" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Acting, step n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;steps 1…n applied to every member&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="310" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="rel" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Releasing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;below threshold since t&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1300" y="310" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="snooze" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Snoozed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3A3D45&quot;&gt;after a manual undo&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="600" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="c103" value="" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i" target="idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c104" value="app CPU ≥ threshold, rule applies" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="idle" target="watch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c105" value="drops below, or rule stops applying" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="watch" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="220"/><mxPoint x="280" y="220"/></Array></mxGeometry></mxCell>
        <mxCell id="c106" value="held for &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;for_secs&lt;/span&gt;: step 1" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="watch" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c107" value="still above, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;after_secs&lt;/span&gt; passed: next step" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=0;entryX=0.8;entryY=0;" edge="1" parent="1" source="act" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="250"/><mxPoint x="1108" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="c108" value="below threshold" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="act" target="rel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c109" value="above again" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.7;entryY=1;" edge="1" parent="1" source="rel" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="470"/><mxPoint x="1082" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="c110" value="below for &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;release_after_secs&lt;/span&gt;: undo all, reverse order" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="rel" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="540"/><mxPoint x="280" y="540"/></Array></mxGeometry></mxCell>
        <mxCell id="c111" value="rule disabled, paused, other profile, context false, app in front: undo all" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.2;exitY=1;entryX=0.2;entryY=1;" edge="1" parent="1" source="act" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="952" y="500"/><mxPoint x="220" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="c112" value="user undoes it" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="act" target="snooze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c113" value="app below threshold" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="snooze" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="640"/></Array></mxGeometry></mxCell>
        <mxCell id="c114" value="&lt;span style=&quot;font-size:11px&quot;&gt;A process that joins the application while it is in Acting gets the steps already taken. Steps are &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;LowerPriority&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;EfficiencyMode&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;CpuCap(percent)&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Notify&lt;/span&gt;; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Notify&lt;/span&gt; has no inverse.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=0;fillColor=#FFFBE6;strokeColor=#C9B458;strokeWidth=1;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="780" width="1380" height="70" as="geometry"/></mxCell>
        <mxCell id="c115" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Legend&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="200" height="16" as="geometry"/></mxCell>
        <mxCell id="c116" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="902" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c117" value="&lt;span style=&quot;font-size:11px&quot;&gt;State&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="98" y="903" width="420" height="16" as="geometry"/></mxCell>
        <mxCell id="c118" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Dyno · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1460" y="966" width="300" height="16" as="geometry"/></mxCell>
