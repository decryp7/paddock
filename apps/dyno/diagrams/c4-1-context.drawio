<mxfile host="drawio" agent="Dyno diagram generator" version="24.7.17" compressed="false">
  <diagram id="Dyno — system context" name="Dyno — system context">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="900" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Dyno — system context&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;C4 · Level 1 — System context&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Dyno measures, explains and tunes one PC for its owner. It reads the operating system through ports, asks the user before it changes anything, and exchanges data with Debrief and Pitwall only when the user clicks (ADR 0001, 0006).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="person" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PC owner&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Watches the machine, asks “why is it slow?”, tames apps, cleans up. Approves every change.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FBEAF3;strokeColor=#BE3584;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="sys" value="&lt;b style=&quot;font-size:12px;color:#555A65&quot;&gt;Dyno&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#555A65;fontSize=12;rounded=1;arcSize=3;absoluteArcSize=0;fillColor=none;strokeColor=#0B6FB0;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="460" height="590" as="geometry"/></mxCell>
        <mxCell id="dyno" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dyno&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Software system]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;A per-user agent that samples, keeps history and runs rules; a Tauri app that shows it; a privileged helper installed only when an admin action is first approved.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="380" height="320" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Local data&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[SQLite + JSON files in the user data folder]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;History, settings, rules, activity log with undo records. Never uploaded.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="os" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Operating system&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Windows · macOS · Linux]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Counters, process table, /proc and /sys, job objects, signals, launchd, systemd, registry, UAC and authorisation prompts.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="hosts" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Release host&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Gitea releases, HTTPS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Serves signed installers and latest.json for Dyno’s own opt-in updates.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="340" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="debrief" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Debrief (planned)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Sister app]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;“Open in Debrief”: a time window exported for deep log analysis.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#686B73;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="pitwall" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pitwall (planned)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Local LLM server]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;“Explain this” on a redacted summary, only on click.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#686B73;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="650" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="backup" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Backup tools (planned)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Time Machine, restic, Borg, …]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Dyno checks that they ran and succeeded; it never runs backups.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#686B73;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="c103" value="Views and approves&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[window and tray]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="person" target="dyno"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="395"/><mxPoint x="420" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="c104" value="Reads sensors, acts on processes&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[dyno_core::ports]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="dyno" target="os"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="278"/><mxPoint x="1010" y="225"/></Array></mxGeometry></mxCell>
        <mxCell id="c105" value="Checks for updates&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[HTTPS, opt-in]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="dyno" target="hosts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="358"/><mxPoint x="990" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="c106" value="Exports a window&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[file, on click]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" parent="1" source="dyno" target="debrief"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="438"/><mxPoint x="970" y="550"/></Array></mxGeometry></mxCell>
        <mxCell id="c107" value="Asks to explain&lt;br&gt;&lt;i style=&quot;color:#555A65&quot;&gt;[local HTTP, on click]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="dyno" target="pitwall"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="518"/><mxPoint x="950" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="c108" value="" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=block;startFill=1;startSize=6;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="data" target="dyno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c109" value="Reports health of" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;entryX=0;entryY=0.85;" edge="1" parent="1" source="backup" target="dyno"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="502"/></Array></mxGeometry></mxCell>
