<mxfile host="drawio" version="32.5.5" compressed="false">
  <diagram id="Dyno — system context" name="Dyno — system context">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Dyno — system context&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1248" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;C4 · Level 1 — System context&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1248" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Dyno measures and explains one PC for its owner. It also keeps the computer awake, wakes other computers, and sleeps, hibernates or shuts down after idle or at a set time, as the owner sets it up. Sister apps and the release host are reached only on a click or an opt-in.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1248" height="20" as="geometry"/></mxCell>
        <mxCell id="owner" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;PC owner&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Watches the machine, asks why it is slow, gets alarms, runs benchmarks on a click.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="48" y="144" width="288" height="112" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="304" y="154" width="14" height="20" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Local data&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[SQLite + JSON in the user data folder]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;History, settings, alarms and notes, snapshots, baselines. Never uploaded.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="48" y="340" width="288" height="96" as="geometry"/></mxCell>
        <mxCell id="os" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Operating system&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Windows · macOS · Linux]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Counters, process table, /proc and /sys, OS logs, launchd, systemd, registry. Figures it shows only to administrators are marked Unavailable.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="48" y="520" width="288" height="128" as="geometry"/></mxCell>
        <mxCell id="hosts" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Release host&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Gitea releases, HTTPS]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Signed installers and latest.json for Dyno's own opt-in updates.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#F4F5F7,#17191E);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1008" y="144" width="288" height="96" as="geometry"/></mxCell>
        <mxCell id="debrief" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Debrief&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Sister app]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Open in Debrief: a time window exported for log analysis.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#FFFFFF,#15171B);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1008" y="280" width="288" height="96" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;planned&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#FFFFFF,#15171B);fontColor=light-dark(#6B7380,#7F8794);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1229" y="288" width="59" height="18" as="geometry"/></mxCell>
        <mxCell id="pitwall" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Pitwall&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Local AI hub, MCP client]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Any local MCP client reads Dyno once AI access is on; Pitwall 1.1 planned.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#FFFFFF,#15171B);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1008" y="416" width="288" height="96" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;planned&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#FFFFFF,#15171B);fontColor=light-dark(#6B7380,#7F8794);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1229" y="424" width="59" height="18" as="geometry"/></mxCell>
        <mxCell id="lan" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Computers on the LAN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Wake-on-LAN]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Other computers the owner saved; Dyno wakes one when asked.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#F4F5F7,#17191E);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1008" y="552" width="288" height="96" as="geometry"/></mxCell>
        <mxCell id="sys" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Dyno&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Tauri app + per-user agent + Rust core]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;A per-user agent that samples, keeps history and raises alarms; a Tauri app (Angular UI) and the dyno command that show it; a pure Rust core that decides. It runs with the user's rights; an optional administrator helper does what needs those rights.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#B01E6E,#F063A8);fillColor=light-dark(#F7E9F1,#382332);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="528" y="144" width="288" height="504" as="geometry"/></mxCell>
        <mxCell id="helper" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;dyno-helper&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Optional OS service]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Turned on in Settings. Reads what needs administrator rights, sets Dyno's own scheduled wakes (macOS, Linux) and installs the pinned disk-health tool on request, with an audit log.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#B01E6E,#F063A8);fillColor=light-dark(#F7E9F1,#382332);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="552" y="484" width="240" height="152" as="geometry"/></mxCell>
