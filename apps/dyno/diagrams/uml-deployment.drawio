        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="1000" as="geometry"/></mxCell>
        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Dyno — deployment&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · Deployment diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;What is installed where on each OS. The agent and the app are separate processes of the same user; the helper is a third, elevated only when an admin action is first approved (ADR 0006, 0010). Windows has no SCM service on purpose.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="32" as="geometry"/></mxCell>
        <mxCell id="mac" value="&lt;b style=&quot;font-size:13px&quot;&gt;macOS 13+&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;Apple Silicon and Intel&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;shape=cube;size=14;darkOpacity=0.05;fillColor=#F7F7F9;strokeColor=#686B73;strokeWidth=1.5;fontColor=#17181C;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="540" height="760" as="geometry"/></mxCell>
        <mxCell id="mac0" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dyno.app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[ad-hoc signed bundle, .dmg]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tauri shell + Angular UI; dyno-agent bundled inside&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="215" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="mac1" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;launchd&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[gui/&amp;lt;uid&amp;gt; domain]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;net.decryptology.dyno.agent.plist in ~/Library/LaunchAgents starts dyno-agent run; KeepAlive&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="350" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="mac2" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dyno-agent&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[user process]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Samples, keeps history, runs rules; ~/Library/Logs/Dyno/agent.log&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F8F1D2;strokeColor=#8F7400;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="485" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="mac3" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Data&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[~/Library/Application Support/Dyno]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;dyno.db, settings.json, rules.json, process-control.json, agent.json&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="620" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="mac4" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dyno-helper (planned)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[daemon, on demand]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Approved in System Settings or by an authorisation prompt&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#8F7400;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="755" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="c103" value="Starts" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mac1" target="mac2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c104" value="Reads and writes" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mac2" target="mac3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="win" value="&lt;b style=&quot;font-size:13px&quot;&gt;Windows 10 / 11&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;x64&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;shape=cube;size=14;darkOpacity=0.05;fillColor=#F7F7F9;strokeColor=#686B73;strokeWidth=1.5;fontColor=#17181C;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="540" height="760" as="geometry"/></mxCell>
        <mxCell id="win0" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dyno (NSIS installer)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[per-user install]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tauri shell + Angular UI on WebView2; dyno-agent.exe beside it&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="215" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="win1" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;HKCU Run entry&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[value “Dyno”]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Starts &quot;dyno-agent.exe&quot; run at logon, in the user’s own session&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="350" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="win2" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dyno-agent.exe&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[user process]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Samples, keeps history, runs rules; named job objects for CPU caps&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F8F1D2;strokeColor=#8F7400;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="485" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="win3" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Data&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[%LOCALAPPDATA%\Dyno]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;dyno.db, settings.json, rules.json, process-control.json, agent.json&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="620" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="win4" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dyno-helper.exe (planned)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[LocalSystem, on demand]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Started after a UAC prompt; exits when idle&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#8F7400;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="710" y="755" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="c105" value="Starts" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="win1" target="win2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c106" value="Reads and writes" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5A6375;fontSize=11;fontColor=#17181C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=6;startArrow=;startFill=1;startSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="win2" target="win3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lin" value="&lt;b style=&quot;font-size:13px&quot;&gt;Linux&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;x86_64 and aarch64 desktops&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;shape=cube;size=14;darkOpacity=0.05;fillColor=#F7F7F9;strokeColor=#686B73;strokeWidth=1.5;fontColor=#17181C;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1300" y="150" width="540" height="760" as="geometry"/></mxCell>
        <mxCell id="lin0" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dyno (.deb or AppImage)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[WebKitGTK]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tauri shell + Angular UI; dyno-agent beside it&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="215" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="lin1" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;systemd --user&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[dyno-agent.service]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;~/.config/systemd/user; Restart=always, Nice=10, MemoryHigh=256M&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="350" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="lin2" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dyno-agent&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[user process]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Samples from /proc and /sys, keeps history, runs rules&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F8F1D2;strokeColor=#8F7400;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="485" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="lin3" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Data&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[~/.local/share/dyno]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;dyno.db, settings.json, rules.json, agent.json; state in ~/.local/state/dyno&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="620" width="470" height="112" as="geometry"/></mxCell>
        <mxCell id="lin4" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;dyno-helper (planned)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[via pkexec, on demand]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;polkit prompt; exits when idle&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#8F7400;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="755" width="470" height="112" as="geometry"/></mxCell>
