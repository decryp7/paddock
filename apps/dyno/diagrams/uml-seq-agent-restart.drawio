        <mxCell id="c100" value="&lt;b style=&quot;font-size:20px&quot;&gt;Agent restart after an app update&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c101" value="&lt;span style=&quot;font-size:12px;color:#555A65&quot;&gt;UML · Sequence diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c102" value="&lt;span style=&quot;font-size:11px;color:#555A65&quot;&gt;An app update replaces the executables; a newer app asks the older agent to exit and the service manager starts the new one. What rules and caps applied is released first and is also recoverable from the control-state file after a crash (ADR 0004, 0010).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1500" height="32" as="geometry"/></mxCell>
        <mxCell id="h_upd" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Updater&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri updater]&lt;/i&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="144" y="140" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="h_app" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;App&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[Tauri shell]&lt;/i&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#E1EEF7;strokeColor=#0B6FB0;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="452" y="140" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="h_old" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Old agent&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[dyno-agent]&lt;/i&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F8F1D2;strokeColor=#8F7400;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="h_svc" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Service manager&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[launchd · systemd · Run]&lt;/i&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#EEEEF1;strokeColor=#686B73;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1068" y="140" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="h_new" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;New agent&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#555A65&quot;&gt;[dyno-agent]&lt;/i&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#F8F1D2;strokeColor=#8F7400;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1376" y="140" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="c103" value="new version installed; relaunch" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="234" y="250" as="sourcePoint"/><mxPoint x="542" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c104" value="read &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;agent.json&lt;/span&gt;: version, pid, token" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="306" as="sourcePoint"/><mxPoint x="542" y="330" as="targetPoint"/><Array as="points"><mxPoint x="612" y="306"/><mxPoint x="612" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="c105" value="connect, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Hello&lt;/span&gt;; versions differ" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="366" as="sourcePoint"/><mxPoint x="850" y="366" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c106" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Request::Shutdown&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="422" as="sourcePoint"/><mxPoint x="850" y="422" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c107" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;release_all()&lt;/span&gt;; remove &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;agent.json&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="478" as="sourcePoint"/><mxPoint x="850" y="502" as="targetPoint"/><Array as="points"><mxPoint x="920" y="478"/><mxPoint x="920" y="502"/></Array></mxGeometry></mxCell>
        <mxCell id="c108" value="process exits" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="538" as="sourcePoint"/><mxPoint x="1158" y="538" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c109" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;KeepAlive&lt;/span&gt; / &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Restart=always&lt;/span&gt; starts the new binary" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1158" y="594" as="sourcePoint"/><mxPoint x="1466" y="594" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c110" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;dyno-agent service ensure&lt;/span&gt; (re-register if stale)" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="650" as="sourcePoint"/><mxPoint x="1158" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c111" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;release_all()&lt;/span&gt; from &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;process-control.json&lt;/span&gt;; open store; migrate" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1466" y="706" as="sourcePoint"/><mxPoint x="1466" y="730" as="targetPoint"/><Array as="points"><mxPoint x="1536" y="706"/><mxPoint x="1536" y="730"/></Array></mxGeometry></mxCell>
        <mxCell id="c112" value="write &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;agent.json&lt;/span&gt;, listen" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1466" y="766" as="sourcePoint"/><mxPoint x="1466" y="790" as="targetPoint"/><Array as="points"><mxPoint x="1536" y="766"/><mxPoint x="1536" y="790"/></Array></mxGeometry></mxCell>
        <mxCell id="c113" value="connect and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Subscribe&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542" y="826" as="sourcePoint"/><mxPoint x="1466" y="826" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c114" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Push(LiveUpdate)&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;edgeStyle=none;html=1;strokeWidth=1.5;strokeColor=#3869BB;fontSize=11;fontColor=#17181C;verticalLabelPosition=top;verticalAlign=bottom;spacingBottom=4;endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1466" y="882" as="sourcePoint"/><mxPoint x="542" y="882" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c115" value="&lt;span style=&quot;font-size:11px&quot;&gt;Windows has no manager that restarts the agent: the app starts it (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;dyno-agent run&lt;/span&gt;) when &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;agent.json&lt;/span&gt; is stale; the Run entry does it at the next logon.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=0;fillColor=#FFFBE6;strokeColor=#C9B458;strokeWidth=1;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="928" width="440" height="60" as="geometry"/></mxCell>
        <mxCell id="c121" value="&lt;span style=&quot;font-size:10px;color:#555A65&quot;&gt;Dyno · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1360" y="994" width="300" height="16" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
