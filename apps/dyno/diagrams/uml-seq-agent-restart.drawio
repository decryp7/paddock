        <mxCell id="c26" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);endArrow=none;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="32" y="617" as="sourcePoint"/><mxPoint x="1064" y="617" as="targetPoint"/></mxGeometry></mxCell>
