        <mxCell id="c26" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Answers&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="649" y="144" width="63" height="18" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="held" target="old"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="568"/><mxPoint x="520" y="568"/></Array></mxGeometry></mxCell>
        <mxCell id="c28" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Repair or Install&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="783" y="540" width="114" height="18" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.2981;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2981;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="idle" target="unin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Switched off&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="59" y="363" width="91" height="18" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.7019;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7019;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="unin" target="idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c32" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Removed&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="250" y="363" width="63" height="18" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;span style=&quot;font-size:12px&quot;&gt;Every start, install, repair, resume and uninstall passes one transition function and writes the record before each OS step. A hold ends when the service answers, the version changes, or the user presses Repair. macOS and Linux share this; Windows Dyno has no agent service.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="96" y="624" width="1168" height="56" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="720" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="c33" value="" style="rounded=1;absoluteArcSize=1;arcSize=4;strokeWidth=1.5;strokeColor=light-dark(#B01E6E,#F063A8);fillColor=light-dark(#F7E9F1,#382332);" vertex="1" parent="1"><mxGeometry x="64" y="732" width="28" height="16" as="geometry"/></mxCell>
