        <mxCell id="c111" value="&lt;span style=&quot;font-size:11px&quot;&gt;macOS: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;launchctl bootout&lt;/span&gt; then &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;bootstrap&lt;/span&gt; on every install. Linux: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;systemctl --user enable --now&lt;/span&gt;. Windows: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;HKCU … Run&lt;/span&gt; value; no manager restarts a crashed agent, the app or the next logon does.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#17181C;fontSize=11;rounded=0;fillColor=#FFFBE6;strokeColor=#C9B458;strokeWidth=1;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="720" width="1300" height="70" as="geometry"/></mxCell>
