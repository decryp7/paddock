        <mxCell id="c20" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Crash or stop&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="440" y="355" width="94" height="18" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.6983;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6983;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="stop" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;OS restarts it&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="642" y="355" width="99" height="18" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;jettySize=auto;orthogonalLoop=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=0;startSize=8;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="stop" target="none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="212" y="460"/></Array></mxGeometry></mxCell>
        <mxCell id="c24" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Uninstall&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="226" y="434" width="63" height="18" as="geometry"/></mxCell>
        <mxCell id="n" value="&lt;span style=&quot;font-size:12px&quot;&gt;macOS: launchctl bootout then bootstrap on every install. Linux: systemctl --user enable --now. Windows: an HKCU Run value; no manager restarts a crashed agent, the app or the next logon does.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="96" y="568" width="984" height="56" as="geometry"/></mxCell>
