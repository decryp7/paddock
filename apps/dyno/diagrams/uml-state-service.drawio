  <diagram id="Service registration" name="Service registration">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Service registration&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1248" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;UML · State machine&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1248" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Status as dyno_agent::service reports it: not installed, or installed with two flags (running, points at this executable). ensure repairs a stale registration but never installs one unasked.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1248" height="20" as="geometry"/></mxCell>
        <mxCell id="ini" value="" style="ellipse;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="260" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="none" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Not installed&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;No plist, unit or Run value.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#B01E6E,#F063A8);fillColor=light-dark(#F7E9F1,#382332);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="216" width="232" height="104" as="geometry"/></mxCell>
        <mxCell id="run" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Registered, running&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Points at the current executable.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#B01E6E,#F063A8);fillColor=light-dark(#F7E9F1,#382332);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="472" y="216" width="232" height="104" as="geometry"/></mxCell>
