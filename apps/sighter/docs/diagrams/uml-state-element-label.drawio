        <mxCell id="sug" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Suggested&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;OCR, template, detector or Pitwall proposed a box.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0A8CA8,#00B8D9);fillColor=light-dark(#E7F4F6,#123139);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="112" y="168" width="152" height="120" as="geometry"/></mxCell>
