# Pins for Sighter's ONNX Runtime builds (stage-2 plan SW5, ADR 0001 decision 4 and P5). Sourced by build-ort.sh and
# fetch-directml.sh, read by .gitea/workflows/sighter-ort.yml. One source: change a pin here and nowhere else.
# Research and dates: docs/research/2026-10-ort-builds.md.

# ONNX Runtime release tag and the commit it names (GitHub API, read 2026-10-30). The build refuses a checkout whose
# HEAD is not this commit.
ORT_VERSION=1.31.1
ORT_COMMIT=6af1a932e2286d5c58166085d24c68783033edee

# Our pipeline revision. Bump it when the flags, the bundling or the toolchain change for the same ORT version: the
# Gitea generic package version is "$ORT_VERSION-p$PIPELINE_REV", and a published version is never overwritten.
PIPELINE_REV=1

# Lowest macOS the arm64 build runs on (the family floor Pacenotes met with pyke's archive; ADR 0001 "Consequences").
MACOS_DEPLOYMENT_TARGET=13.4

# DirectML redistributable (NuGet Microsoft.AI.DirectML 1.15.4, published 2024-10-28; the version ONNX Runtime 1.31.1's
# cmake/external/dml.cmake restores). The package SHA-512 is NuGet's own catalogue hash (base64); the file hashes were
# measured on the verified package on 2026-10-30.
DML_VERSION=1.15.4
DML_NUPKG_URL=https://api.nuget.org/v3-flatcontainer/microsoft.ai.directml/1.15.4/microsoft.ai.directml.1.15.4.nupkg
DML_NUPKG_SHA512_B64=/edn9WkEq8kP1T9l2HKckYq39uPF4ezdR5kI/AK0U1zysIYPerKsubcx1suAm3LD1dTQKFP7j16gIqR7xE7yhQ==
DML_NUPKG_SIZE=202292617
DML_X64_DLL_SHA256=9c9e6d822561c6c41b90e6994b3e8857cf1d66dbfb1e0c4c799c7c89b4e92da1
DML_ARM64_DLL_SHA256=77b0db83ff903f2323f5caf538499d75af6038bbea23b7959f7d232d9a4ab9d4

# Where the built archives are published: a Gitea generic package (immutable per version and file name).
GITEA_PACKAGES=https://dev.decryptology.net/api/packages/decryp7/generic
ORT_PACKAGE=sighter-onnxruntime
