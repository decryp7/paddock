{
  "$comment": "The processes Debrief may start, for scripts/vm-smoke (see apps/dyno/vm-smoke.json for the field list). min 0: a helper that is started on demand.",
  "id": "debrief",
  "app": "Debrief",
  "bundle": "Debrief.app",
  "dataDir": "~/Library/Application Support/Debrief",
  "logs": [
    "~/Library/Application Support/Debrief/logs/app.log"
  ],
  "quit": {
    "appleScriptName": "Debrief"
  },
  "updateHost": "dev.decryptology.net",
  "readyTimeoutSec": 180,
  "settleSec": 20,
  "processes": [
    {
      "name": "debrief-app",
      "role": "app",
      "max": 1
    },
    {
      "name": "debrief-plugins",
      "role": "helper",
      "min": 0,
      "max": 1,
      "parents": [
        "app"
      ]
    },
    {
      "name": "debrief-store-worker",
      "role": "helper",
      "min": 0,
      "max": 1,
      "parents": [
        "app"
      ]
    }
  ],
  "settleWhy": "Default 20 s: no timer of this app's own start path was derived yet; raise it when the app gets a spawn-retry timer longer than that."
}
