{
  "$comment": "Debrief's CI contract (./dev plan, ADR 0014 §6). Debrief is not a leg of ci.yml: its gates (Rust on Linux and macOS, plugin SDK, licences, frontend, e2e, real-app smoke on three OS, installers, the release) are its own workflow, .gitea/workflows/debrief.yml, whose plan job asks `./dev plan --ci --app debrief`. Its nightly jobs are debrief-bench, -corpus, -fuzz and -mutants.yml.",
  "workflow": "debrief.yml",
  "cargo": ".",
  "notices": {
    "name": "Debrief",
    "manifests": [
      "app/src-tauri/Cargo.toml",
      "crates/debrief-plugins/Cargo.toml",
      "crates/debrief-store-worker/Cargo.toml"
    ],
    "npm": "app",
    "out": [
      "app/src-tauri/resources"
    ]
  },
  "hostTests": {
    "packages": [
      "cargo-debrief-plugin",
      "chromium-driver",
      "debrief-agent",
      "debrief-ai",
      "debrief-app",
      "debrief-cli",
      "debrief-collect",
      "debrief-core",
      "debrief-etw",
      "debrief-ipc",
      "debrief-monitor",
      "debrief-plugin-api",
      "debrief-plugin-dotnet",
      "debrief-plugin-dumps",
      "debrief-plugin-host",
      "debrief-plugin-native",
      "debrief-plugin-package",
      "debrief-plugin-test",
      "debrief-plugin-tools",
      "debrief-plugin-windows",
      "debrief-plugins",
      "debrief-store-client",
      "debrief-store-duck",
      "debrief-store-worker",
      "debrief-symbols",
      "debrief-video",
      "xtask"
    ]
  }
}
