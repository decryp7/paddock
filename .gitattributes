# Source text is stored with LF; checkouts may use the platform's line endings.
* text=auto

# Test inputs are byte-exact (checksums are computed over them). Never convert their line endings.
crates/*/tests/fixtures/** -text

# Shell scripts must keep LF to run on macOS and Linux.
*.sh text eol=lf

# Binary formats.
*.png binary
*.ico binary
*.icns binary
*.gz binary
*.xz binary
*.zip binary

# The same for fixtures that sit beside tests/ (paddock-testplan): a CRLF checkout would break the text comparisons.
crates/*/fixtures/** -text

# Windows batch files keep CRLF.
*.cmd text eol=crlf
