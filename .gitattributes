# Source text is stored with LF; checkouts may use the platform's line endings.
* text=auto

# Test inputs are byte-exact (checksums are computed over them). Never convert their line endings.
crates/*/tests/fixtures/** -text

# Shell scripts must keep LF to run on macOS and Linux.
*.sh text eol=lf

# Rust sources keep LF so multi-line string literals (templates, expected output) match on Windows checkouts.
*.rs text eol=lf

# Binary formats.
*.png binary
*.ico binary
*.icns binary
*.gz binary
*.xz binary
*.zip binary

# The same for fixtures that sit beside tests/ (paddock-testplan): a CRLF checkout would break the text comparisons.
crates/*/fixtures/** -text

# Windows batch files keep CRLF.
*.cmd text eol=crlf

# The ./dev wrapper and the tool's input list are read by sh: LF on every checkout.
/dev text eol=lf
/tools/paddock-dev/inputs.txt text eol=lf

# Packaging files a Linux package ships (maintainer scripts run by sh, the systemd unit, the polkit rule, the macOS plists a test compares byte for
# byte with a render): LF on every checkout. A Windows checkout with CRLF broke `#!/bin/sh\r` and the unit comparison in CI (run 7494).
/apps/*/app/src-tauri/linux/** text eol=lf
/apps/*/app/src-tauri/macos/*.plist text eol=lf

# Generated TypeScript goldens are compared with the generator output: LF on every checkout (a CRLF checkout failed paddock-limits on Windows, run 7706).
crates/*/tests/golden/** text eol=lf

# The tables job-isolation.sh reads line by line: a CRLF checkout (Windows) gave every last field a carriage return.
conformance/ci/*.txt text eol=lf

# paddock-dev's tests compare these text files with strings the tool prints (the shim `./dev hooks install` writes, the CI timings golden):
# a CRLF checkout (Windows) failed both on the Windows runner (run 7904).
/tools/githooks/* text eol=lf
/tools/paddock-dev/tests/** text eol=lf

# The lessons log only gains sections, so two branches that both add one at the end merge without a conflict (union keeps both
# sides' lines). Union is wrong for a file whose lines are edited in place (both versions are kept, with no conflict to warn):
# benchmarks.md and the apps' performance.md (results blocks are corrected in place), registers and generated files are never
# listed here. See docs/lessons.md (2026-11-15).
/docs/lessons.md merge=union

# Append-only changelogs: every member adds its entry at the top of a section, so two branches (and a train merge or a member
# revert) conflicted on the same lines. union keeps both sides' lines and never conflicts. Trade-off: the order within a section
# is not guaranteed (the two sides' lines come one after the other), and an entry edited in place by both sides is kept twice
# instead of conflicting, so a reviewer reads the merged section.
/CHANGELOG.md merge=union
/apps/*/CHANGELOG.md merge=union

# The generated ADR index: every member's regenerate adds its row at the end, so two branches that each add an ADR conflicted.
# union lets the merge go through; the generator's --check (./dev gen check, CI, pre-push) then fails on the merged file until
# `node conformance/bin/paddock-adr-index.mjs` is run: one command, never a hand merge. This is the exception to the rule above
# (generated files are not listed) and holds only because the file has a --check that refuses a stale merge result. The check list
# (conformance/src/checks/index.mjs, paddock.ci.json) is NOT listed: union breaks the JSON (the last array element needs no comma),
# and the generator cannot repair what it cannot parse.
/docs/adr/README.md merge=union
