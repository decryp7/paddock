# Source text is stored with LF; checkouts may use the platform's line endings.
* text=auto

# Test inputs are byte-exact (checksums are computed over them). Never convert their line endings.
crates/*/tests/fixtures/** -text

# Shell scripts must keep LF to run on macOS and Linux.
*.sh text eol=lf

# Rust sources keep LF so multi-line string literals (templates, expected output) match on Windows checkouts.
*.rs text eol=lf

# Binary formats.
*.png binary
*.ico binary
*.icns binary
*.gz binary
*.xz binary
*.zip binary

# The same for fixtures that sit beside tests/ (paddock-testplan): a CRLF checkout would break the text comparisons.
crates/*/fixtures/** -text

# Windows batch files keep CRLF.
*.cmd text eol=crlf

# The ./dev wrapper and the tool's input list are read by sh: LF on every checkout.
/dev text eol=lf
/tools/paddock-dev/inputs.txt text eol=lf

# Packaging files a Linux package ships (maintainer scripts run by sh, the systemd unit, the polkit rule, the macOS plists a test compares byte for
# byte with a render): LF on every checkout. A Windows checkout with CRLF broke `#!/bin/sh\r` and the unit comparison in CI (run 7494).
/apps/*/app/src-tauri/linux/** text eol=lf
/apps/*/app/src-tauri/macos/*.plist text eol=lf

# Generated TypeScript goldens are compared with the generator output: LF on every checkout (a CRLF checkout failed paddock-limits on Windows, run 7706).
crates/*/tests/golden/** text eol=lf
