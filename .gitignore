# The root npm workspace (ADR 0014 §1): every package's dependencies, hoisted or nested, are never source.
node_modules

# Anchored on purpose: an unanchored rule can hide source folders.
/ui/node_modules/
/ui/dist/
/ui/.angular/
/ui/out-tsc/
/ui/coverage/
/ui/test-results/
/ui/dialog-check/
# Generated from scss/ by `npm run build:css`.
/ui/projects/paddock-ui/css/
/crates/target/
# The paddock-dev tool's local build folder (./dev builds it there on a cache miss).
/tools/paddock-dev/target/
/crates/.cargo/ci.toml
/tools/paddock-dev/.cargo/ci.toml
.DS_Store

# Icon set build deps
/icons/node_modules/

# The shell demo app (apps/shell-demo): its Tauri CLI, Tauri's generated schemas, a local build folder and bundles.
/apps/shell-demo/node_modules/
/apps/shell-demo/src-tauri/gen/
/apps/shell-demo/src-tauri/target/
/apps/shell-demo/dist/
# The agent copied for Tauri's externalBin (scripts/shell-demo/sidecar.mjs) or the build step's empty placeholder.
/apps/shell-demo/src-tauri/binaries/
/eslint/node_modules

# Coverage data (a test child that outlives its parent leaves one in its working folder).
*.profraw
*.profdata

# The workbench demo app (apps/workbench-demo): its Tauri CLI, Tauri's generated schemas, a local build folder and bundles.
/apps/workbench-demo/node_modules/
/apps/workbench-demo/src-tauri/gen/
/apps/workbench-demo/src-tauri/target/
/apps/workbench-demo/dist/
/vm-smoke-results/
/apps/dyno/app/src-tauri/windows/paddock-setup.exe
/crates/paddock-setup/nsis/test/*.exe
# The heavy tool's local build folder.
/tools/heavy/target/
