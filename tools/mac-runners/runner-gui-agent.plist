<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ADR 0120 (D1 = option D): the one capacity-1 GUI lane, a LaunchAgent in a logged-in Aqua session, for the work that needs
  the window server (the ADR's inventory rows 6 to 8 and 10). A template: tools/mac-runner-move.sh fills the values marked
  @set-by-mac-runner-move@ with plutil, copying them from the lane's current LaunchAgent. LimitLoadToSessionType Aqua keeps
  it out of a background or SSH session, where it would start with no window server.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@set-by-mac-runner-move@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@set-by-mac-runner-move@</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@set-by-mac-runner-move@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>@set-by-mac-runner-move@</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@set-by-mac-runner-move@</string>
	<key>StandardErrorPath</key>
	<string>@set-by-mac-runner-move@</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ExitTimeOut</key>
	<integer>10800</integer>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
	<key>HardResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>65536</integer>
	</dict>
</dict>
</plist>
