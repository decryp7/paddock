#!/bin/sh
# ./dev: runs paddock-dev, the Paddock developer and CI tool (ADR 0022). Works from any subfolder: it finds the repository
# root with git and runs the tool in the folder you are in. The tool is a content-addressed binary: the hash of its inputs
# (tools/paddock-dev/inputs.txt, from git, plus the compiler cargo will use) names it. Order: the per-user cache, the
# prebuilt download (R0b: not wired yet), then a local build. A build also happens whenever an input has uncommitted
# changes, because then HEAD's hash cannot describe it. `./dev --wrapper-hash` prints the hash and stops.
# Environment: PADDOCK_DEV_TARGET_DIR (build folder, default tools/paddock-dev/target, which is ignored by git),
# PADDOCK_DEV_HOME (cache, default ~/.paddock-dev), PADDOCK_DEV_FRESH=1 (build from source in a fresh folder without a
# compiler wrapper, as release jobs do).
set -eu

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "dev: run this inside the Paddock repository." >&2; exit 2; }
tool="$root/tools/paddock-dev"
inputs=$(grep -v '^[[:space:]]*#' "$tool/inputs.txt" | grep -v '^[[:space:]]*$' | tr '\n' ' ')

# runs <file>: an executable that answers --version with some text (an empty or truncated file is not a tool; sh would run an
# empty file as an empty script and call that success).
runs() { [ -x "$1" ] && v=$("$1" --version 2>/dev/null) && [ -n "$v" ]; }

# Where cargo reads configuration for the tool, closest first (the tool's folder, tools/, the root, $CARGO_HOME).
config_dirs="$tool/.cargo|$root/tools/.cargo|$root/.cargo|${CARGO_HOME:-${HOME:-}/.cargo}"
home="${PADDOCK_DEV_HOME:-${HOME:-/nonexistent}/.paddock-dev}"
exe=
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) exe=.exe ;; esac

# The compiler cargo will use: RUSTC, CARGO_BUILD_RUSTC, `rustc =` under [build] in a config.toml (closest first), else rustc
# run from the tool's folder (so a rustup override applies).
rustc_cmd=${RUSTC:-${CARGO_BUILD_RUSTC:-}}
if [ -z "$rustc_cmd" ]; then
  old_ifs=$IFS
  IFS='|'
  for dir in $config_dirs; do
    [ -f "$dir/config.toml" ] || continue
    rustc_cmd=$(awk '
      /^[ \t]*\[/ { sec = $0; gsub(/[ \t]/, "", sec); next }
      sec == "[build]" && /^[ \t]*rustc[ \t]*=/ {
        v = $0; sub(/^[^=]*=[ \t]*/, "", v); sub(/^"/, "", v); sub(/"[ \t]*(#.*)?$/, "", v); print v; exit
      }' "$dir/config.toml")
    [ -n "$rustc_cmd" ] && break
  done
  IFS=$old_ifs
fi
if ! vv=$(cd "$tool" && "${rustc_cmd:-rustc}" -vV 2>/dev/null | tr -d '\r') || [ -z "$vv" ]; then
  # Without a compiler the hash cannot be computed, but a binary built earlier still works.
  newest=$(ls -t "$home"/bin/*/paddock-dev-*"$exe" 2>/dev/null | head -n 1)
  if [ -n "$newest" ] && runs "$newest"; then
    echo "dev: rustc is not available; running the newest cached tool binary ($newest)." >&2
    exec "$newest" "$@"
  fi
  echo "dev: rustc was not found (${rustc_cmd:-rustc}). Install Rust with rustup (https://rustup.rs), then run ./dev again." >&2
  exit 2
fi
compiler=$(printf '%s\n' "$vv" | grep -E '^(commit-hash|release):')
host=$(printf '%s\n' "$vv" | sed -n 's/^host: //p')

# What else changes the compiled code: RUSTFLAGS, CARGO_ENCODED_RUSTFLAGS and every `rustflags =` line (build or target tables)
# in the configs above.
flags=$(
  printf 'RUSTFLAGS=%s\nCARGO_ENCODED_RUSTFLAGS=%s\n' "${RUSTFLAGS:-}" "${CARGO_ENCODED_RUSTFLAGS:-}"
  old_ifs=$IFS
  IFS='|'
  for dir in $config_dirs; do
    [ -f "$dir/config.toml" ] && grep -h '^[[:space:]]*rustflags[[:space:]]*=' "$dir/config.toml" | tr -d '\r'
  done
  IFS=$old_ifs
)

# shellcheck disable=SC2086 # inputs.txt holds paths without spaces
hash=$({ git -C "$root" ls-tree HEAD -- $inputs; printf '%s\n%s\n' "$compiler" "$flags"; } | git -C "$root" hash-object --stdin)
# shellcheck disable=SC2086
dirty=$(git -C "$root" status --porcelain --untracked-files=all -- $inputs)

if [ "${1:-}" = "--wrapper-hash" ]; then
  echo "$hash"
  [ -n "$dirty" ] && echo dirty || echo clean
  exit 0
fi

name="paddock-dev-$host$exe"
export PADDOCK_DEV_WRAPPER_HASH="$hash"

build() { # build <target dir>: the binary ends up in <target dir>/release/paddock-dev
  (cd "$tool" && CARGO_TARGET_DIR="$1" PADDOCK_DEV_HASH="${2:-dirty}" cargo build --release --locked --quiet)
}

if [ "${PADDOCK_DEV_FRESH:-}" = 1 ]; then
  fresh=$(mktemp -d)
  trap 'rm -rf "$fresh"' EXIT
  (unset RUSTC_WRAPPER; cd "$tool" && CARGO_TARGET_DIR="$fresh" PADDOCK_DEV_HASH="$hash" cargo build --release --locked --quiet)
  "$fresh/release/paddock-dev$exe" "$@"
  exit $?
fi

if [ -n "$dirty" ]; then
  build "${PADDOCK_DEV_TARGET_DIR:-$tool/target}" dirty
  exec "${PADDOCK_DEV_TARGET_DIR:-$tool/target}/release/paddock-dev$exe" "$@"
fi

cache="$home/bin/$hash"
# A cached binary must run: an empty or damaged file (a copy that was cut short) is removed and rebuilt.
if [ -e "$cache/$name" ] && ! runs "$cache/$name"; then
  echo "dev: the cached tool binary $cache/$name does not run; rebuilding it." >&2
  rm -f "$cache/$name"
fi
if [ ! -x "$cache/$name" ]; then
  # R0b: download the published binary for this hash (Gitea generic package `paddock-dev`, version <hash>) and check its
  # .sha256 here. Until the publishing workflow exists, every miss builds.
  target=${PADDOCK_DEV_TARGET_DIR:-$tool/target}
  build "$target" "$hash"
  mkdir -p "$cache"
  cp "$target/release/paddock-dev$exe" "$cache/$name.$$"
  mv -f "$cache/$name.$$" "$cache/$name"
fi
exec "$cache/$name" "$@"
