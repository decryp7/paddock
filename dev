#!/bin/sh
# ./dev: runs paddock-dev, the Paddock developer and CI tool (ADR 0022). Works from any subfolder: it finds the repository
# root with git and runs the tool in the folder you are in. The tool is a content-addressed binary: the hash of its inputs
# (tools/paddock-dev/inputs.txt, from git, plus the compiler cargo will use) names it. Order: the per-user cache (on a CI runner the
# kept mount, see below), the prebuilt download (R0b: on a CI runner by default, elsewhere with PADDOCK_DEV_DOWNLOAD=1), then a local build. A build also happens whenever an input has
# uncommitted changes, because then HEAD's hash cannot describe it. `./dev --wrapper-hash` prints the hash and stops.
# Environment: PADDOCK_DEV_TARGET_DIR (build folder, default tools/paddock-dev/target, which is ignored by git),
# PADDOCK_DEV_HOME (cache, default ~/.paddock-dev), PADDOCK_CI_MOUNT (a CI runner's kept mount, default /sccache),
# PADDOCK_DEV_FRESH=1 (build from source in a fresh folder without a compiler wrapper, as release jobs do).
# Download: PADDOCK_DEV_DOWNLOAD (1 on, 0 off; default on only when GITHUB_ACTIONS=true), PADDOCK_DEV_PACKAGES (the Gitea generic
# package base, default https://dev.decryptology.net/api/packages/paddock-build-inputs/generic), PADDOCK_DEV_TOKEN (read token, else the job's
# GITHUB_TOKEN; sent through curl's stdin config, never on a command line), PADDOCK_DEV_DOWNLOAD_TIMEOUT (seconds per file, default 60).
set -eu

# Set by a restart (restart_or_fail) for this run only: the tool and anything it starts, a nested ./dev included, must not inherit it.
restarted=${PADDOCK_DEV_RESTARTED:-}
unset PADDOCK_DEV_RESTARTED

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "dev: run this inside the Paddock repository." >&2; exit 2; }
tool="$root/tools/paddock-dev"
[ -f "$tool/inputs.txt" ] || {
  echo "dev: tools/paddock-dev is not in this checkout (a sparse checkout without it). Run: git sparse-checkout add tools" >&2
  exit 2
}
inputs=$(grep -v '^[[:space:]]*#' "$tool/inputs.txt" | grep -v '^[[:space:]]*$' | tr '\n' ' ')

# runs <file>: an executable that answers --version with some text (an empty or truncated file is not a tool; sh would run an
# empty file as an empty script and call that success).
runs() { [ -x "$1" ] && v=$("$1" --version 2>/dev/null) && [ -n "$v" ]; }

# On a CI runner with a kept mount (a Linux container's /sccache, which the node-caches action also uses) the tool and its build
# folder live there, so a plan job compiles the tool once per hash and not on every run. An explicit PADDOCK_DEV_HOME or
# PADDOCK_DEV_TARGET_DIR wins.
ci_mount="${PADDOCK_CI_MOUNT:-/sccache}"
kept_target=
if [ "${GITHUB_ACTIONS:-}" = true ] && [ -d "$ci_mount" ] && [ -w "$ci_mount" ]; then
  if [ -z "${PADDOCK_DEV_HOME:-}" ]; then
    PADDOCK_DEV_HOME="$ci_mount/paddock-dev"
    # One build folder per hash (below): jobs of other hashes on the same mount never replace the binary this job just built.
    [ -n "${PADDOCK_DEV_TARGET_DIR:-}" ] || kept_target=1
  fi
fi
home="${PADDOCK_DEV_HOME:-${HOME:-/nonexistent}/.paddock-dev}"
# A run that never downloads (PADDOCK_DEV_DOWNLOAD=0: release and tag jobs) keeps its tools in its own folder, bin-source, which the
# download path never writes: what it runs was built from source by a run that also did not download.
binroot=bin
[ "${PADDOCK_DEV_DOWNLOAD:-}" = 0 ] && binroot=bin-source
exe=
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) exe=.exe ;; esac

# The config files cargo reads for the tool, closest first, one per line: `config.toml` and `config` in every `.cargo` folder
# from the tool's own up to the filesystem root, the other `*.toml` files of the tool's `.cargo` (what `include` pulls in, such
# as the git-ignored ci.toml), then $CARGO_HOME's. The same list, in the same order, is built by the tool's input_hash.rs.
config_files() {
  d=$tool
  while :; do
    for f in config.toml config; do
      if [ -f "$d/.cargo/$f" ]; then printf '%s\n' "$d/.cargo/$f"; fi
    done
    if [ "$d" = "$tool" ]; then
      for f in $(cd "$d/.cargo" 2>/dev/null && LC_ALL=C ls ./*.toml 2>/dev/null); do
        case "$f" in ./config.toml) ;; *) printf '%s\n' "$d/.cargo/${f#./}" ;; esac
      done
    fi
    parent=$(dirname "$d")
    [ "$parent" = "$d" ] && break
    d=$parent
  done
  ch=${CARGO_HOME:-${HOME:-}/.cargo}
  for f in config.toml config; do
    if [ -f "$ch/$f" ]; then printf '%s\n' "$ch/$f"; fi
  done
}
# Without duplicates (CARGO_HOME is usually also an ancestor's `.cargo`).
configs=$(config_files | awk '!seen[$0]++')

# The compiler cargo will use: RUSTC, CARGO_BUILD_RUSTC, `rustc =` under [build] (or a dotted `build.rustc =`) in a config
# (closest first), else rustc run from the tool's folder (so a rustup override applies).
rustc_cmd=${RUSTC:-${CARGO_BUILD_RUSTC:-}}
if [ -z "$rustc_cmd" ] && [ -n "$configs" ]; then
  while IFS= read -r cfg; do
    rustc_cmd=$(awk '
      /^[ \t]*\[/ { sec = $0; gsub(/[ \t]/, "", sec); next }
      (sec == "[build]" && /^[ \t]*rustc[ \t]*=/) || (sec == "" && /^[ \t]*build\.rustc[ \t]*=/) {
        v = $0; sub(/^[^=]*=[ \t]*/, "", v); sub(/^"/, "", v); sub(/"[ \t]*(#.*)?$/, "", v); print v; exit
      }' "$cfg")
    [ -n "$rustc_cmd" ] && break
  done <<EOF
$configs
EOF
fi
# toolchain_file: the rust-toolchain(.toml) rustup reads for the tool's folder, found the way rustup finds it (the closest one above).
toolchain_file() {
  d=$tool
  while :; do
    for f in rust-toolchain.toml rust-toolchain; do
      if [ -f "$d/$f" ]; then printf '%s\n' "$d/$f"; return 0; fi
    done
    parent=$(dirname "$d")
    [ "$parent" = "$d" ] && return 1
    d=$parent
  done
}

# run_bounded <seconds> <command...>: runs it in the background and ends it at the limit (ER-32: no wait without a maximum). The
# command is ended by the pid this function started, never by a name.
run_bounded() {
  _lim=$1
  shift
  "$@" &
  _pid=$!
  _t=0
  while kill -0 "$_pid" 2>/dev/null; do
    if [ "$_t" -ge "$_lim" ]; then
      kill "$_pid" 2>/dev/null || true
      wait "$_pid" 2>/dev/null || true
      return 124
    fi
    sleep 1
    _t=$((_t + 1))
  done
  wait "$_pid"
}

# ensure_toolchain: the toolchain the repository pins (rust-toolchain.toml, with the profile and components it asks for) is installed.
# rustup 1.28 no longer installs a pinned toolchain by itself, so a runner that has rustup but not yet that version has a `rustc` shim
# that cannot run (run 8034: build-jobs ran ./dev before setup-rust, and the wrapper fell back to an old cached tool). Only when rustc
# does not run, rustup exists, no compiler was named by RUSTC or a cargo config, and a toolchain file exists. Bounded by
# PADDOCK_DEV_TOOLCHAIN_TIMEOUT (seconds, default 900), logged with its duration; a failure says the next step. Returns 0 when rustc
# runs afterwards.
ensure_toolchain() {
  [ -z "${rustc_cmd:-}" ] || return 1
  command -v rustup >/dev/null 2>&1 || return 1
  tf=$(toolchain_file) || return 1
  _i0=$(date +%s)
  echo "dev: rustc does not run here; installing the toolchain $tf pins with rustup (at most ${PADDOCK_DEV_TOOLCHAIN_TIMEOUT:-900} s)." >&2
  _rc=0
  (cd "$tool" && run_bounded "${PADDOCK_DEV_TOOLCHAIN_TIMEOUT:-900}" rustup toolchain install >&2) || _rc=$?
  if [ "$_rc" -ne 0 ]; then
    echo "::error::./dev: 'rustup toolchain install' for $tf failed (exit $_rc, $(($(date +%s) - _i0)) s; 124 means the time limit). Run it by hand in tools/paddock-dev to see why (network, disk, a proxy), then run ./dev again." >&2
    return 1
  fi
  echo "dev: installed the pinned toolchain in $(($(date +%s) - _i0)) s." >&2
  return 0
}

if [ "${1:-}" = "--ensure-toolchain" ]; then
  # For conformance/ci/kit.sh and setup steps: succeeds when the compiler runs (installed if need be).
  rustc_cmd=${RUSTC:-${CARGO_BUILD_RUSTC:-}}
  (cd "$tool" && "${rustc_cmd:-rustc}" -vV >/dev/null 2>&1) && exit 0
  ensure_toolchain && (cd "$tool" && "${rustc_cmd:-rustc}" -vV >/dev/null 2>&1) && exit 0
  echo "::error::./dev --ensure-toolchain: no Rust compiler runs here. Install Rust with rustup (https://rustup.rs) or the toolchain rust-toolchain.toml pins, then run ./dev again." >&2
  exit 2
fi

if ! vv=$(cd "$tool" && "${rustc_cmd:-rustc}" -vV 2>/dev/null | tr -d '\r') || [ -z "$vv" ]; then
  if ensure_toolchain; then vv=$(cd "$tool" && "${rustc_cmd:-rustc}" -vV 2>/dev/null | tr -d '\r' || true); fi
fi
if [ -z "${vv:-}" ]; then
  # Without a compiler the hash cannot be computed, and no cached binary is run in its place: it may be older than this commit's
  # tool and lack the subcommand asked for (run 8034: it exited 2 on `ci build-jobs`). Fail closed (ER-33).
  echo "::error::./dev: no Rust compiler runs here (${rustc_cmd:-rustc}), so the tool's hash cannot be computed and no cached paddock-dev is run in its place (it may lack this command). Install Rust with rustup (https://rustup.rs) or the toolchain rust-toolchain.toml pins (rustup toolchain install, in tools/paddock-dev), then run ./dev again; rustc was not found." >&2
  exit 2
fi
compiler=$(printf '%s\n' "$vv" | grep -E '^(commit-hash|release):' || true)
if ! printf '%s\n' "$compiler" | grep -q '^release:'; then
  echo "dev: ${rustc_cmd:-rustc} -vV printed no release line, so it is not a Rust compiler this tool can identify." >&2
  exit 2
fi
host=$(printf '%s\n' "$vv" | sed -n 's/^host: //p')
# The compiler's own key (its commit, else its release): a build folder is never shared between two compilers, because cargo
# keeps rlibs of the old one beside the new ones and a half-replaced toolchain reads them as E0514 (run 8027, pitwall-mac).
ckey=$(printf '%s\n' "$compiler" | sed -n 's/^commit-hash: //p' | cut -c1-12)
[ -n "$ckey" ] || ckey=$(printf '%s\n' "$compiler" | sed -n 's/^release: //p' | tr -c 'A-Za-z0-9.\n' '_')

# compiler_now: the `compiler` lines of the compiler as it is now (empty when it does not run), asked the way it was asked above.
compiler_now() {
  (cd "$tool" && "${rustc_cmd:-rustc}" -vV 2>/dev/null | tr -d '\r' | grep -E '^(commit-hash|release):') || true
}

# only_build_folder <file>: the config sets nothing but the build folder (`target-dir` in `[build]`, or a top-level
# `build.target-dir`), besides blank lines and comments. The build folder never changes the binary (CARGO_TARGET_DIR is not
# hashed either), and CI's build-folder action writes exactly such a ci.toml next to the tool in the middle of a job. Prints
# nothing, so a trace never shows what the file holds.
only_build_folder() {
  tr -d '\r' <"$1" | awk '
    { line = $0; sub(/^[ \t]+/, "", line) }
    line == "" || line ~ /^#/ { next }
    line ~ /^\[/ { sec = line; gsub(/[ \t]/, "", sec); if (sec != "[build]") bad = 1; next }
    (sec == "[build]" && line ~ /^target-dir[ \t]*=/) || (sec == "" && line ~ /^build\.target-dir[ \t]*=/) { next }
    { bad = 1 }
    END { exit bad ? 1 : 0 }'
}

# What else changes the compiled code: the environment variables RUSTFLAGS, CARGO_ENCODED_RUSTFLAGS, CARGO_BUILD_*,
# CARGO_PROFILE_* and CARGO_TARGET_* (not the build folder, the job count or the compiler, which the `-vV` lines already name)
# when they are not empty, sorted as lines, then one `config-file <digest>` line per config file above (except those that only
# name the build folder), the digest being git's blob id of the file with carriage returns dropped. A config file can hold
# registry tokens, so it is streamed into git and only its digest is ever held in a variable (which `sh -x` would print).
flags=$(
  env | grep -E '^(RUSTFLAGS|CARGO_ENCODED_RUSTFLAGS|CARGO_BUILD_[A-Za-z0-9_]*|CARGO_PROFILE_[A-Za-z0-9_]*|CARGO_TARGET_[A-Za-z0-9_]*)=' |
    grep -v -E '^(CARGO_TARGET_DIR|CARGO_BUILD_JOBS|CARGO_BUILD_TARGET_DIR|CARGO_BUILD_RUSTC)=' | grep -v '=$' | LC_ALL=C sort || true
  if [ -n "$configs" ]; then
    while IFS= read -r cfg; do
      only_build_folder "$cfg" && continue
      printf 'config-file %s\n' "$(tr -d '\r' <"$cfg" | git -C "$root" hash-object --stdin)"
    done <<EOF
$configs
EOF
  fi
)

# shellcheck disable=SC2086 # inputs.txt holds paths without spaces
hash=$({ git -C "$root" ls-tree HEAD -- $inputs; printf '%s\n%s\n' "$compiler" "$flags"; } | git -C "$root" hash-object --stdin)
# shellcheck disable=SC2086
dirty=$(git -C "$root" status --porcelain --untracked-files=all -- $inputs)

# The inputs of the hash that are not the tracked files, one line, so a miss (a binary published under another hash) can be
# explained from the logs alone (ER-27): the compiler release, the names (never the values) of the hashed environment variables,
# and the digests of the cargo config files.
explain_hash() {
  echo "dev: hash $hash inputs: $(printf '%s' "$compiler" | tr '\n' ' ')| env: $(printf '%s\n' "$flags" | grep -v '^config-file ' | sed 's/=.*//' | tr '\n' ' ')| configs: $(printf '%s\n' "$configs" | tr '\n' ' ')| digests: $(printf '%s\n' "$flags" | sed -n 's/^config-file //p' | cut -c1-8 | tr '\n' ' ')" >&2
}

if [ "${1:-}" = "--wrapper-hash" ]; then
  explain_hash
  echo "$hash"
  [ -n "$dirty" ] && echo dirty || echo clean
  exit 0
fi

name="paddock-dev-$host$exe"
export PADDOCK_DEV_WRAPPER_HASH="$hash"

# cargo puts a binary built for an explicit target under <target dir>/<triple>/, not release/.
refuse_build_target() {
  [ -z "${CARGO_BUILD_TARGET:-}" ] || {
    echo "dev: CARGO_BUILD_TARGET is set, so cargo would put the tool outside target/release. Unset it for ./dev." >&2
    exit 2
  }
}

# build <target dir> [hash]: the binary ends up in <target dir>/release/paddock-dev. Returns 0, 1 (failed, said aloud) or 75 (the
# compiler changed during the build: the caller starts over once, see restart_or_fail).
build() {
  refuse_build_target
  (cd "$tool" && CARGO_TARGET_DIR="$1" PADDOCK_DEV_HASH="${2:-dirty}" cargo build --release --locked --quiet) || {
    code=$?
    toolchain_changed "$code" || return $?
    echo "::error::./dev could not build paddock-dev (hash ${2:-dirty}, cargo exit $code, build folder $1). Run 'cargo build --release --locked' in tools/paddock-dev to see why; a stale tools/paddock-dev/Cargo.lock is the usual cause." >&2
    return 1
  }
  toolchain_changed 0 || return $?
  built_check "$1"
}
# The compiler is the one the hash named, or the build is not trusted: a rustup update during the build (the toolchain folder is
# replaced in place) gives cargo errors that look like a broken build (E0514, a missing rustc.exe on Windows) and a binary the
# hash does not describe. Once per run the wrapper starts over with the new compiler (a new hash, a new build folder); the second
# time it says so and fails.
toolchain_changed() { # toolchain_changed <cargo exit code>
  now=$(compiler_now)
  [ "$now" = "$compiler" ] && return 0
  echo "::warning::./dev: the Rust compiler changed while paddock-dev was building (it was: $(printf '%s' "$compiler" | tr '\n' ' '); now: $(printf '%s' "${now:-not found}" | tr '\n' ' '); cargo exit $1), probably a rustup update on this host." >&2
  if [ -z "$restarted" ]; then return 75; fi
  echo "::error::./dev: the Rust compiler changed again during the second build, so paddock-dev was not built. Wait for the toolchain update on this host to finish, then run ./dev again (see 'rustup show')." >&2
  return 1
}
# A `build.target` in a cargo config (or --target in cargo's own settings) puts the binary under <target>/<triple>/: say so
# instead of failing later on a missing file.
built_check() {
  [ -x "$1/release/paddock-dev$exe" ] || {
    echo "dev: cargo did not leave the tool at $1/release/paddock-dev$exe. A cargo config probably sets build.target; remove it for ./dev." >&2
    exit 2
  }
}

# Prebuilt download (ADR 0022 R0b). Fetches the tool published for this hash and compiler target from the Gitea generic package
# `paddock-dev` (version <hash>, file <name>, checksum <name>.sha256), checks the checksum and that the binary reports the hash it
# was built for, then publishes it into the cache with an atomic rename. Returns 1 (after a ::notice:: or ::warning::) on any miss
# or doubt, and the caller builds: a binary that was not checked is never run.
download_enabled() {
  case "${PADDOCK_DEV_DOWNLOAD:-}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ "${GITHUB_ACTIONS:-}" = true ]
}
download_prebuilt() {
  _base=${PADDOCK_DEV_PACKAGES:-https://dev.decryptology.net/api/packages/paddock-build-inputs/generic}
  _tmo=${PADDOCK_DEV_DOWNLOAD_TIMEOUT:-60}
  command -v curl >/dev/null 2>&1 || {
    echo "::notice::./dev cannot download the prebuilt paddock-dev: curl is not installed. Building it." >&2
    return 1
  }
  if ! mkdir -p "$cache" || ! _dl=$(mktemp -d "$cache/.download.XXXXXX"); then
    echo "::notice::./dev cannot write the cache folder $cache, so it cannot keep a download. Building it." >&2
    return 1
  fi
  # Whether a token exists, without its value ever reaching a trace (a subshell with tracing off).
  _tokinfo=$({ set +x; } 2>/dev/null; if [ -n "${PADDOCK_DEV_TOKEN:-${GITHUB_TOKEN:-}}" ]; then echo 'a read token was sent'; else echo 'no read token is set: export PADDOCK_DEV_TOKEN'; fi)
  _t0=$(date +%s)
  for _f in "$name.sha256" "$name"; do
    # The token goes in through curl's config on stdin (so no process list shows it) and tracing is off while it is written.
    _code=$({ set +x; } 2>/dev/null; { printf 'header = "Authorization: token %s"\n' "${PADDOCK_DEV_TOKEN:-${GITHUB_TOKEN:-}}"; } |
      curl -sS -K - --connect-timeout 10 --max-time "$_tmo" -o "$_dl/$_f" -w '%{http_code}' "$_base/paddock-dev/$hash/$_f" 2>"$_dl/curl.err") || _code=000
    case "$_code" in
      200) ;;
      404)
        echo "::notice::./dev: paddock-dev $hash is not published for $host (HTTP 404 for $_f); building it." >&2
        explain_hash
        rm -rf "$_dl"
        return 1
        ;;
      *)
        echo "::warning::./dev could not download $_base/paddock-dev/$hash/$_f (HTTP $_code after $(($(date +%s) - _t0)) s, timeout ${_tmo} s, $_tokinfo): $(head -c 300 "$_dl/curl.err" 2>/dev/null | tr '\n' ' ') Building it instead." >&2
        rm -rf "$_dl"
        return 1
        ;;
    esac
  done
  _want=$(tr -d '\r' <"$_dl/$name.sha256" | awk '{print $1; exit}')
  if command -v sha256sum >/dev/null 2>&1; then
    _got=$(sha256sum "$_dl/$name" | awk '{print $1}')
  else
    _got=$(shasum -a 256 "$_dl/$name" | awk '{print $1}')
  fi
  if [ -z "$_want" ] || [ "$_want" != "$_got" ]; then
    echo "::warning::./dev: the downloaded $name has checksum ${_got:-unknown}, the published one says ${_want:-nothing}: the checksum does not match, so it is not used. Building it instead." >&2
    rm -rf "$_dl"
    return 1
  fi
  chmod +x "$_dl/$name"
  if ! "$_dl/$name" self hash 2>/dev/null | grep -q "^embedded $hash\$"; then
    echo "::warning::./dev: the downloaded $name is not for hash $hash (it reports another one, or none). Building it instead." >&2
    rm -rf "$_dl"
    return 1
  fi
  if ! mv -f "$_dl/$name" "$cache/$name"; then
    echo "::warning::./dev could not move the downloaded $name into $cache. Building it instead." >&2
    rm -rf "$_dl"
    return 1
  fi
  rm -rf "$_dl"
  echo "dev: downloaded paddock-dev $hash for $host in $(($(date +%s) - _t0)) s, transport checks passed (checksum, embedded hash)." >&2
  return 0
}

# restart_or_fail <build status> <the wrapper's arguments>: 75 starts the wrapper over once (the compiler changed under the build),
# anything else ends it (the failure was said aloud).
restart_or_fail() {
  _rc=$1
  shift
  if [ "$_rc" -eq 75 ]; then
    echo "dev: starting over once with the compiler that is installed now." >&2
    PADDOCK_DEV_RESTARTED=1 exec /bin/sh "$0" "$@"
  fi
  exit 1
}

if [ "${PADDOCK_DEV_FRESH:-}" = 1 ]; then
  refuse_build_target
  fresh=$(mktemp -d)
  trap 'rm -rf "$fresh"' EXIT
  (unset RUSTC_WRAPPER; cd "$tool" && CARGO_TARGET_DIR="$fresh" PADDOCK_DEV_HASH="$hash" cargo build --release --locked --quiet)
  built_check "$fresh"
  "$fresh/release/paddock-dev$exe" "$@"
  exit $?
fi

if [ -n "$dirty" ]; then
  # A build of uncommitted inputs is nobody's cached tool, and a job must not pin one that changes under it.
  if [ "${1:-}" = --print-binary ]; then
    echo "dev: --print-binary: the tool's inputs have uncommitted changes, so there is no cached binary to name." >&2
    exit 3
  fi
  # One folder per compiler: cargo's rlibs of another compiler are never in it. Cargo's own lock on the folder serialises two
  # builds of the same compiler; the tool built here is nobody's cached tool.
  dirty_target="${PADDOCK_DEV_TARGET_DIR:-$tool/target}/rustc-$ckey"
  build "$dirty_target" dirty || restart_or_fail $? "$@"
  exec "$dirty_target/release/paddock-dev$exe" "$@"
fi

cache="$home/$binroot/$hash"
# A cached binary must run: an empty or damaged file (a copy that was cut short) is removed and rebuilt.
if [ -e "$cache/$name" ] && ! runs "$cache/$name"; then
  echo "dev: the cached tool binary $cache/$name does not run; rebuilding it." >&2
  rm -f "$cache/$name"
fi
if [ ! -x "$cache/$name" ]; then
  fetched=
  if download_enabled && download_prebuilt; then fetched=1; fi
  if [ -z "$fetched" ]; then
    # One build folder per compiler (never one that spans two): cargo's own lock on it serialises builds of one compiler, a
    # change to an input rebuilds only the tool's own crate (warm), and a build of another compiler cannot meet its rlibs (run 8027:
    # E0514). It sits next to the cache in a kept mount, else inside PADDOCK_DEV_TARGET_DIR (or the tool's own target folder).
    if [ -n "$kept_target" ]; then tbase=$home; else tbase=${PADDOCK_DEV_TARGET_DIR:-$tool/target}; fi
    if [ -z "$kept_target" ] && [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${PADDOCK_DEV_HOME:-}" ]; then
      echo "::notice::./dev builds paddock-dev in this job: the runner has no writable $ci_mount, so nothing is kept between runs (cold build, about a minute or two)." >&2
    fi
    target=$tbase/rustc-$ckey
    if ! mkdir -p "$target"; then
      echo "::error::./dev cannot make the build folder $target. Make $tbase writable or set PADDOCK_DEV_TARGET_DIR to a folder you can write, then run ./dev again." >&2
      exit 1
    fi
    _b0=$(date +%s)
    # A name of our own in the cache folder (never a PID: the folder may be shared by containers whose PIDs repeat), checked for the
    # hash it was built for before it replaces anything, then published by an atomic rename. Another build of this compiler (another
    # hash, one folder) can replace the binary between cargo's end and the copy: then the copy names the wrong hash and the build is
    # run again, at most three times.
    _try=0
    while :; do
      _try=$((_try + 1))
      touch "$target" 2>/dev/null || true
      echo "dev: building paddock-dev $hash in $target (compiler $ckey, try $_try)." >&2
      build "$target" "$hash" || restart_or_fail $? "$@"
      mkdir -p "$cache"
      tmp=$(mktemp "$cache/$name.XXXXXX")
      cp "$target/release/paddock-dev$exe" "$tmp"
      chmod +x "$tmp"
      if "$tmp" self hash 2>/dev/null | grep -q "^embedded $hash\$"; then break; fi
      rm -f "$tmp"
      if [ "$_try" -ge 3 ]; then
        echo "::error::./dev built a paddock-dev that is not for hash $hash three times in a row (another run builds in $target, or the build ignored PADDOCK_DEV_HASH). Run ./dev again; if it repeats, report it with this log." >&2
        exit 1
      fi
    done
    if ! mv -f "$tmp" "$cache/$name"; then
      # Windows cannot replace a tool that another job is running: the same hash, so that tool is as good as ours.
      rm -f "$tmp"
      if runs "$cache/$name" && "$cache/$name" self hash 2>/dev/null | grep -q "^embedded $hash\$"; then
        echo "dev: another run published paddock-dev $hash first; using it." >&2
      else
        echo "::error::./dev could not publish paddock-dev $hash into $cache. Close programs that use it or delete the folder, then run ./dev again." >&2
        exit 1
      fi
    fi
    echo "dev: built paddock-dev $hash in $(($(date +%s) - _b0)) s (not downloaded)." >&2
  fi
  # Keep the five newest cached tools (and their build folders); older hashes are rebuilt on demand. A tool used within the last
  # day is never removed: a job on the same mount (several runners share a host's tools folder) runs it again at its end, when its
  # temp folder is already gone and a rebuild cannot work (run 7773, job-isolation release).
  ls -t "$home/$binroot" | tail -n +6 | while IFS= read -r old; do
    if [ -n "$(find "$home/$binroot/$old" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then
      rm -rf "${home:?}/$binroot/$old" || true
      [ -d "$home/bin/$old" ] || [ -d "$home/bin-source/$old" ] || rm -rf "${home:?}/target-$old" "${home:?}/target-$old".* || true
    fi
  done
  # Build folders of compilers no longer installed go a week after their last build (each build touches its own folder). A build
  # is never judged by the age of a folder: the folder of the compiler in use is never removed, and nothing else is built in a
  # `rustc-*` folder of another compiler by this wrapper. Legacy per-hash folders (`target-<hash>.*`, an earlier wrapper) go
  # when a day old and their hash was never published; they have no owner record, so nothing younger is touched.
  for t in "$home"/rustc-* "${PADDOCK_DEV_TARGET_DIR:-$tool/target}"/rustc-*; do
    [ -d "$t" ] || continue
    [ "${t##*/}" = "rustc-$ckey" ] && continue
    if [ -n "$(find "$t" -maxdepth 0 -mtime +7 2>/dev/null)" ]; then rm -rf "${t:?}" || true; fi
  done
  for t in "$home"/target-* "${PADDOCK_DEV_TARGET_DIR:-$tool/target}"/target-*; do
    [ -d "$t" ] || continue
    h=${t##*/target-}; h=${h%%.*}
    [ -d "$home/bin/$h" ] && continue
    [ -d "$home/bin-source/$h" ] && continue
    if [ -n "$(find "$t" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then rm -rf "${t:?}" || true; fi
  done
fi
# A hit counts as use: the prune keeps the newest-used tools, so main's hash outlives a stream of branch hashes.
touch "$cache" 2>/dev/null || true
# `--print-binary`: where the tool is (built if need be), without running it. job-isolation pins it for the whole job: the hash
# covers files the job itself writes (tools/paddock-dev/.cargo/ci.toml), so at the job's end ./dev would want another build.
if [ "${1:-}" = --print-binary ]; then printf '%s\n' "$cache/$name"; exit 0; fi
exec "$cache/$name" "$@"
