#!/bin/sh
# ./dev, stage 0 (shell-to-rust WP-1, ADR 0022 amendment 2026-11-15): builds the launcher, tools/dev-launch, once and runs it. The
# launcher (std-only Rust) does the rest: the input hash, the toolchain install, the download, the build and the cache. Only shell
# builtins, git, cargo and rustup are used. `./dev --wrapper-hash` prints the hash; PADDOCK_DEV_* variables are the launcher's.
set -eu
# A git hook runs its commands with GIT_DIR and GIT_WORK_TREE set: the repository is the one this folder is in, never an inherited one.
unset GIT_DIR GIT_WORK_TREE
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "dev: run this inside the Paddock repository." >&2; exit 2; }
l=$root/tools/dev-launch
[ -f "$l/Cargo.toml" ] || { echo "dev: tools/dev-launch is not in this checkout (a sparse checkout without it). Run: git sparse-checkout add tools" >&2; exit 2; }
b=$l/target/release/dev-launch
bin=$b
[ -f "$bin" ] || bin=$b.exe
stale=
for f in "$l/Cargo.toml" "$l/Cargo.lock" "$l"/src/*.rs; do [ "$bin" -nt "$f" ] || { stale=1; break; }; done
if [ -n "$stale" ]; then
  # rustup 1.28 does not install a pinned toolchain by itself, so `cargo` may not run yet: build the launcher with any installed
  # toolchain (the first of `rustup toolchain list`), and the launcher installs the pin.
  tc=
  if ! cargo --version >/dev/null 2>&1 && command -v rustup >/dev/null 2>&1; then
    tc=$(rustup toolchain list 2>/dev/null | { read -r t _ || :; printf '%s' "$t"; })
  fi
  # shellcheck disable=SC2086 # tc is one word or empty
  env -u CARGO_BUILD_TARGET ${tc:+RUSTUP_TOOLCHAIN=$tc} cargo build -q --release --locked --manifest-path "$l/Cargo.toml" --target-dir "$l/target" || {
    echo "::error::./dev could not build its launcher (tools/dev-launch, Rust 1.89 or newer). Install Rust with rustup (https://rustup.rs) and run ./dev again; to see why, run 'cargo build --release --locked' in tools/dev-launch." >&2
    exit 1
  }
  bin=$b
  [ -f "$bin" ] || bin=$b.exe
fi
exec "$bin" "$@"
