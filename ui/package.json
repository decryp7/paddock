{
  "name": "paddock-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "The shared design system of the Paddock app family: tokens, components and chart theme.",
  "scripts": {
    "ng": "ng",
    "build:css": "node scripts/build-css.mjs",
    "build": "npm run build:css && ng build paddock-ui",
    "test": "npm run build:css && ng test paddock-ui --watch=false",
    "test:tokens": "vitest run --config vitest.tokens.config.ts",
    "gallery": "npm run build:css && ng serve gallery --port 4300",
    "gallery:build": "npm run build:css && ng build gallery",
    "screenshots": "SCREENSHOTS=1 playwright test",
    "build:e2e": "node scripts/build-e2e.mjs",
    "shell-demo": "npm run build:css && ng serve shell-demo --port 4301",
    "shell-demo:build": "npm run build:css && ng build shell-demo",
    "test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test ../scripts/*.test.mjs projects/paddock-ui/bin/*.test.mjs projects/paddock-e2e/src/*.test.ts",
    "i18n": "node scripts/build-i18n.mjs",
    "i18n:check": "node scripts/build-i18n.mjs --check",
    "check:dialogs": "node projects/paddock-ui/bin/paddock-check-dialog-commands.mjs --config projects/shell-demo/paddock-dialog-commands.json",
    "release": "node ../scripts/publish.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.3",
    "@ngrx/signals": "^22.0.1",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.4",
    "sass": "^1.106.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
