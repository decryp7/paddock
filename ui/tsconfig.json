{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@decryp7/paddock-ui": ["./projects/paddock-ui/src/public-api.ts"],
      "@decryp7/paddock-ui/*": ["./projects/paddock-ui/*/public-api.ts"]
    }
  },
  "angularCompilerOptions": { "strictInjectionParameters": true, "strictInputAccessModifiers": true, "strictTemplates": true },
  "files": [],
  "references": [
    { "path": "./projects/paddock-ui/tsconfig.lib.json" },
    { "path": "./projects/paddock-ui/tsconfig.spec.json" },
    { "path": "./projects/gallery/tsconfig.app.json" },
    { "path": "./projects/shell-demo/tsconfig.app.json" },
    { "path": "./projects/paddock-e2e/tsconfig.json" }
  ]
}
