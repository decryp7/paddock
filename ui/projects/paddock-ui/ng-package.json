{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/paddock-ui",
  "assets": [
    { "input": "scss", "glob": "_*.scss", "output": "scss" },
    { "input": "scss", "glob": "entry-*.scss", "output": "scss" },
    { "input": "css", "glob": "*.css", "output": "css" },
    { "input": "bin", "glob": "*.mjs", "ignore": ["*.test.mjs"], "output": "bin" }
  ],
  "lib": { "entryFile": "src/public-api.ts" }
}
