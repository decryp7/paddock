{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/paddock-e2e",
    "rootDir": "src",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "importHelpers": false,
    "noEmit": false,
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
